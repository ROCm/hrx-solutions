// Exact Llama 3.2 3B Q4_K_M dimensions and numerical facts.
config.def @llama.model.layer_count = 28 : index
config.def @llama.model.hidden_size = 3072 : index
config.def @llama.model.ffn_size = 8192 : index
config.def @llama.model.query_heads = 24 : index
config.def @llama.model.kv_heads = 8 : index
config.def @llama.model.head_size = 128 : index
config.def @llama.model.kv_size = 1024 : index
config.def @llama.model.vocabulary_size = 128256 : index
config.def @llama.model.rms_epsilon = 0.00001 : f32

// GGUF Q/K rows are already permuted for adjacent-pair RoPE.
// rope_freqs.weight supplies 64 F32 divisors; the base alone is insufficient.
config.def @llama.model.rope_base = 500000.0 : f32
config.def @llama.model.rope_dimensions = 128 : index
config.def @llama.model.rope_factor_count = 64 : index
config.def @llama.model.rope_factor_bytes = 256 : index

// Original checkpoint storage; Q4_K=144 and Q6_K=210 bytes per 256 values.
// V/down Q6 layers: 0,1,2,5,8,11,14,17,20,23,24,25,26,27.
// token_embd.weight is Q6_K and is also the output matrix; output.weight is absent.
config.def @llama.model.v_down_q6_layers = 261245223 : i32
config.def @llama.model.norm_weight_bytes = 12288 : index
config.def @llama.model.embedding_weight_bytes = 323205120 : index
config.def @llama.model.query_weight_bytes = 5308416 : index
config.def @llama.model.key_weight_bytes = 1769472 : index
config.def @llama.model.value_q4_weight_bytes = 1769472 : index
config.def @llama.model.value_q6_weight_bytes = 2580480 : index
config.def @llama.model.attention_output_weight_bytes = 5308416 : index
config.def @llama.model.ffn_gate_up_weight_bytes = 14155776 : index
config.def @llama.model.ffn_down_q4_weight_bytes = 14155776 : index
config.def @llama.model.ffn_down_q6_weight_bytes = 20643840 : index

// Fixed output bounds for the existing canonical projection kernels.
config.def @ggml.linear_q4k_q8_1_x4.output_capacity = 8192 : index
config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 128256 : index

// Capacity of the existing shared greedy implementation (historical symbol).
config.def @qwen38.greedy_argmax.output_capacity = 128256 : index
