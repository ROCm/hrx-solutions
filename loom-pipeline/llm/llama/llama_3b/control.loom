// Llama 3.2 3B text policy. Native carries source-private chat state and the
// two cold stage IDs; all physical buffers arrive through the unchanged ABI.
func.decl import("runner") @execute_6(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer, %b5: hal.buffer) -> (i64)
func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)
func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)
func.decl import("json") @members(%text: buffer) -> (buffer, i32, i64)
func.decl import("json") @unescape(%source: buffer, %offset: i64, %length: i64, %target: buffer, %target_offset: i64) -> (i64)
func.decl import("json") @parse_i64(%source: buffer, %offset: i64, %length: i64) -> (i64)
func.decl import("json") @parse_f64(%source: buffer, %offset: i64, %length: i64) -> (f64)
func.decl @generation.accumulate_progress(%progress: buffer, %row_value: index, %consumed: i32, %known: i32, %outputs: i32, %verifications: i32, %source_position: i32) -> (index)
func.decl @generation.copy_tokens(%source: buffer, %source_origin: offset, %count_value: index, %progress: buffer, %row_value: index, %first_value: index)
func.decl @generation.plan_step(%initialize: i32, %source_position: i32, %input_count: i32, %prefill: i32, %decode: i32) -> (i32, i32)
func.decl @llama32_native_token(%token: i32, %eos: i32) -> (i32)

