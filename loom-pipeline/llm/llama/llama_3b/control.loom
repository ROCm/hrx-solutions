func.def @chat_equal(%a: buffer, %b: buffer) -> (i1) {
  %a_length = buffer.length %a
  %b_length = buffer.length %b
  %same_length = index.cmp eq, %a_length, %b_length : offset
  %same = scf.if %same_length -> (i1) {
    %zero = index.constant 0 : offset
    %compared = buffer.compare %a[%zero], %b[%zero], %a_length
    %equal = scalar.constant 0 : i32
    %matches = scalar.cmpi eq, %compared, %equal : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant 0 : i1
    scf.yield %false : i1
  }
  func.return %same : i1
}

func.def @chat_join(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer) {
  %a_size = buffer.length %a
  %b_size = buffer.length %b
  %c_size = buffer.length %c
  %d_size = buffer.length %d
  %e_size = buffer.length %e
  %f_size = buffer.length %f
  %g_size = buffer.length %g
  %h_size = buffer.length %h
  %ab = index.add %a_size, %b_size : offset
  %abc = index.add %ab, %c_size : offset
  %abcd = index.add %abc, %d_size : offset
  %abcde = index.add %abcd, %e_size : offset
  %abcdef = index.add %abcde, %f_size : offset
  %abcdefg = index.add %abcdef, %g_size : offset
  %size = index.add %abcdefg, %h_size : offset
  %output = buffer.alloca<private> align(1) %size : buffer
  %zero = index.constant 0 : offset
  buffer.copy %a[%zero], %output[%zero], %a_size
  buffer.copy %b[%zero], %output[%a_size], %b_size
  buffer.copy %c[%zero], %output[%ab], %c_size
  buffer.copy %d[%zero], %output[%abc], %d_size
  buffer.copy %e[%zero], %output[%abcd], %e_size
  buffer.copy %f[%zero], %output[%abcde], %f_size
  buffer.copy %g[%zero], %output[%abcdef], %g_size
  buffer.copy %h[%zero], %output[%abcdefg], %h_size
  func.return %output : buffer
}

func.def @chat_range(%text: buffer, %begin: i64, %length: i64) -> (buffer) {
  %bounded_begin = scalar.assume %begin [range(%begin, 0, 9223372036854775807)] : i64
  %bounded_length = scalar.assume %length [range(%length, 0, 9223372036854775807)] : i64
  %start = index.cast %bounded_begin : i64 to offset
  %size = index.cast %bounded_length : i64 to offset
  %zero = index.constant 0 : offset
  %result = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%start], %result[%zero], %size
  func.return %result : buffer
}

func.def @request_check(%condition: i1) {
  %value = scalar.extui %condition : i1 to i32
  %diagnostic = global.load @unsupported : buffer
  func.call @require(%value, %diagnostic) : (i32, buffer) -> ()
  func.return
}

// Python/Jinja str.strip whitespace encoded as UTF8. Check complete byte
// sequences before reading them; preserve all other Unicode and embedded NUL.
func.def @space_width(%text: buffer, %position: offset, %end: offset) -> (offset) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %two = index.constant 2 : offset
  %three = index.constant 3 : offset
  %b0 = buffer.load.i8.u %text[%position]
  %c9 = scalar.constant 9 : i32
  %c13 = scalar.constant 13 : i32
  %c28 = scalar.constant 28 : i32
  %c32 = scalar.constant 32 : i32
  %lo = scalar.cmpi uge, %b0, %c9 : i32
  %hi = scalar.cmpi ule, %b0, %c13 : i32
  %tab = scalar.andi %lo, %hi : i1
  %lo2 = scalar.cmpi uge, %b0, %c28 : i32
  %hi2 = scalar.cmpi ule, %b0, %c32 : i32
  %ascii2 = scalar.andi %lo2, %hi2 : i1
  %ascii = scalar.ori %tab, %ascii2 : i1
  %width = scf.if %ascii -> (offset) {
    scf.yield %one : offset
  } else {
    %remaining = index.sub %end, %position : offset
    %has_two = index.cmp uge, %remaining, %two : offset
    %multibyte = scf.if %has_two -> (offset) {
      %p1 = index.add %position, %one : offset
      %b1 = buffer.load.i8.u %text[%p1]
      %c194 = scalar.constant 194 : i32
      %c133 = scalar.constant 133 : i32
      %c160 = scalar.constant 160 : i32
      %lead = scalar.cmpi eq, %b0, %c194 : i32
      %nel = scalar.cmpi eq, %b1, %c133 : i32
      %nbsp = scalar.cmpi eq, %b1, %c160 : i32
      %tail = scalar.ori %nel, %nbsp : i1
      %two_space = scalar.andi %lead, %tail : i1
      %two_result = scf.if %two_space -> (offset) {
        scf.yield %two : offset
      } else {
        %has_three = index.cmp uge, %remaining, %three : offset
        %three_result = scf.if %has_three -> (offset) {
          %p2 = index.add %position, %two : offset
          %b2 = buffer.load.i8.u %text[%p2]
          %c128 = scalar.constant 128 : i32
          %c129 = scalar.constant 129 : i32
          %c138 = scalar.constant 138 : i32
          %c154 = scalar.constant 154 : i32
          %c159 = scalar.constant 159 : i32
          %c168 = scalar.constant 168 : i32
          %c169 = scalar.constant 169 : i32
          %c175 = scalar.constant 175 : i32
          %c225 = scalar.constant 225 : i32
          %c226 = scalar.constant 226 : i32
          %c227 = scalar.constant 227 : i32
          %a0 = scalar.cmpi eq, %b0, %c225 : i32
          %a1 = scalar.cmpi eq, %b1, %c154 : i32
          %a2 = scalar.cmpi eq, %b2, %c128 : i32
          %aa = scalar.andi %a0, %a1 : i1
          %a = scalar.andi %aa, %a2 : i1
          %b0ok = scalar.cmpi eq, %b0, %c226 : i32
          %b1ok = scalar.cmpi eq, %b1, %c128 : i32
          %runlo = scalar.cmpi uge, %b2, %c128 : i32
          %runhi = scalar.cmpi ule, %b2, %c138 : i32
          %run = scalar.andi %runlo, %runhi : i1
          %line = scalar.cmpi eq, %b2, %c168 : i32
          %paragraph = scalar.cmpi eq, %b2, %c169 : i32
          %narrow = scalar.cmpi eq, %b2, %c175 : i32
          %lp = scalar.ori %line, %paragraph : i1
          %r0 = scalar.ori %run, %lp : i1
          %r1 = scalar.ori %r0, %narrow : i1
          %bb = scalar.andi %b0ok, %b1ok : i1
          %b = scalar.andi %bb, %r1 : i1
          %c1ok = scalar.cmpi eq, %b1, %c129 : i32
          %c2ok = scalar.cmpi eq, %b2, %c159 : i32
          %cc = scalar.andi %b0ok, %c1ok : i1
          %c = scalar.andi %cc, %c2ok : i1
          %d0ok = scalar.cmpi eq, %b0, %c227 : i32
          %dd = scalar.andi %d0ok, %b1ok : i1
          %d = scalar.andi %dd, %a2 : i1
          %ab = scalar.ori %a, %b : i1
          %cd = scalar.ori %c, %d : i1
          %match = scalar.ori %ab, %cd : i1
          %result = scf.select %match, %three, %zero : offset
          scf.yield %result : offset
        } else {
          scf.yield %zero : offset
        }
        scf.yield %three_result : offset
      }
      scf.yield %two_result : offset
    } else {
      scf.yield %zero : offset
    }
    scf.yield %multibyte : offset
  }
  func.return %width : offset
}

func.def @chat_trim(%text: buffer) -> (buffer) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %length = buffer.length %text
  %begin = scf.while(%position = %zero : offset) -> (offset) {
    %active = index.cmp ult, %position, %length : offset
    %width = scf.if %active -> (offset) {
      %width = func.call @space_width(%text, %position, %length) : (buffer, offset, offset) -> (offset)
      scf.yield %width : offset
    } else { scf.yield %zero : offset }
    %space = index.cmp ne, %width, %zero : offset
    scf.condition %space, %position : i1, offset
  } do(%position: offset) {
    %width = func.call @space_width(%text, %position, %length) : (buffer, offset, offset) -> (offset)
    %next = index.add %position, %width : offset
    scf.yield %next : offset
  }
  %position, %end = scf.while(%position = %begin : offset, %end = %begin : offset) -> (offset, offset) {
    %active = index.cmp ult, %position, %length : offset
    scf.condition %active, %position, %end : i1, offset, offset
  } do(%position: offset, %end: offset) {
    %width = func.call @space_width(%text, %position, %length) : (buffer, offset, offset) -> (offset)
    %space = index.cmp ne, %width, %zero : offset
    %step = scf.select %space, %width, %one : offset
    %next = index.add %position, %step : offset
    %next_end = scf.select %space, %end, %next : offset
    scf.yield %next, %next_end : offset, offset
  }
  %size = index.sub %end, %begin : offset
  %result = buffer.alloca<private> align(1) %size : buffer
  buffer.copy %text[%begin], %result[%zero], %size
  func.return %result : buffer
}

func.def public @request_defaults(%options: buffer) -> (buffer) {
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.constant 2 : i32
  %empty_count = scalar.constant 0 : i64
  %typed = scalar.cmpi eq, %type, %object : i32
  %empty_options = scalar.cmpi eq, %count, %empty_count : i64
  %valid = scalar.andi %typed, %empty_options : i1
  func.call @request_check(%valid) : (i1)
  %empty = global.load @empty : buffer
  func.return %empty : buffer
}

func.def public @request_options(%defaults: buffer, %request: buffer, %nonce: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %fields, %type, %count = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %object = scalar.constant 2 : i32
  %is_object = scalar.cmpi eq, %type, %object : i32
  func.call @request_check(%is_object) : (i1)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %capacity = buffer.length %request
  %storage = buffer.alloca<private> align(1) %capacity : buffer
  %temperature = global.load @request_temperature : buffer
  %top_p = global.load @request_top_p : buffer
  %top_k = global.load @request_top_k : buffer
  %seed = global.load @request_seed : buffer
  scf.for %i = [%c0 to %extent step %c1] {
    %begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %used = func.call @unescape(%request, %begin, %length, %storage, %zero64) : (buffer, i64, i64, buffer, i64) -> (i64)
    %bounded_used = scalar.assume %used [range(%used, 0, 9223372036854775807)] : i64
    %key_length = index.cast %bounded_used : i64 to offset
    %key = buffer.alloca<private> align(1) %key_length : buffer
    buffer.copy %storage[%origin], %key[%origin], %key_length
    %is_temperature = func.call @chat_equal(%key, %temperature) : (buffer, buffer) -> (i1)
    %is_p = func.call @chat_equal(%key, %top_p) : (buffer, buffer) -> (i1)
    %is_k = func.call @chat_equal(%key, %top_k) : (buffer, buffer) -> (i1)
    %is_seed = func.call @chat_equal(%key, %seed) : (buffer, buffer) -> (i1)
    %floating = scalar.ori %is_temperature, %is_p : i1
    %integer = scalar.ori %is_k, %is_seed : i1
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %valid = scf.if %floating -> (i1) {
      %value = func.call @parse_f64(%request, %value_begin, %value_length) : (buffer, i64, i64) -> (f64)
      %greedy_temperature = scalar.constant 0.0 : f64
      %full_probability = scalar.constant 1.0 : f64
      %expected = scf.select %is_temperature, %greedy_temperature, %full_probability : f64
      %valid = scalar.cmpf oeq, %value, %expected : f64
      scf.yield %valid : i1
    } else {
      %valid = scf.if %integer -> (i1) {
        %value = func.call @parse_i64(%request, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
        %small = scalar.cmpi ule, %value, %one64 : i64
        %valid = scalar.ori %small, %is_seed : i1
        scf.yield %valid : i1
      } else {
        %true = scalar.constant true : i1
        scf.yield %true : i1
      }
      scf.yield %valid : i1
    }
    %condition = scalar.extui %valid : i1 to i32
    %error = global.load @request_sampling_error : buffer
    func.call @require(%condition, %error) : (i32, buffer)
  }
  %policy_date = func.call @date_value(%request) : (buffer) -> (buffer)
  func.return %defaults : buffer
}

func.def public @bind_request(%state: buffer, %row: i32, %options: buffer) { func.return }
func.def public @model_name() -> (buffer) {
  %name = global.load @model : buffer
  func.return %name : buffer
}

func.def @date_value(%request: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero64 = scalar.constant 0 : i64
  %string_type = scalar.constant 0 : i64
  %object_type = scalar.constant 2 : i32
  %fields, %type, %count = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %type, %object_type : i32
  func.call @request_check(%object) : (i1)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %default = global.load @date : buffer
  %date_key = global.load @date_key : buffer
  %model_key = global.load @model_options : buffer
  %thinking_key = global.load @thinking_key : buffer
  %custom_tools_key = global.load @custom_tools_key : buffer
  %tools_in_user_key = global.load @tools_in_user_key : buffer
  %template_kwargs_key = global.load @template_kwargs_key : buffer
  %date = scf.for %i = [%zero to %extent step %one](%prior = %default : buffer) -> (buffer) {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_size = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %key_capacity = buffer.length %request
    %key_storage = buffer.alloca<private> align(1) %key_capacity : buffer
    %key_used = func.call @unescape(%request, %key_begin, %key_size, %key_storage, %zero64) : (buffer, i64, i64, buffer, i64) -> (i64)
    %key_bounded = scalar.assume %key_used [range(%key_used, 0, 9223372036854775807)] : i64
    %key_extent = index.cast %key_bounded : i64 to offset
    %key = buffer.alloca<private> align(1) %key_extent : buffer
    buffer.copy %key_storage[%origin], %key[%origin], %key_extent
    %is_date = func.call @chat_equal(%key, %date_key) : (buffer, buffer) -> (i1)
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_size = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %next = scf.if %is_date -> (buffer) {
      %string = scalar.cmpi eq, %value_type, %string_type : i64
      func.call @request_check(%string) : (i1)
      %capacity = buffer.length %request
      %storage = buffer.alloca<private> align(1) %capacity : buffer
      %used = func.call @unescape(%request, %value_begin, %value_size, %storage, %zero64) : (buffer, i64, i64, buffer, i64) -> (i64)
      %used_bounded = scalar.assume %used [range(%used, 0, 9223372036854775807)] : i64
      %used_offset = index.cast %used_bounded : i64 to offset
      %value = buffer.alloca<private> align(1) %used_offset : buffer
      buffer.copy %storage[%origin], %value[%origin], %used_offset
      scf.yield %value : buffer
    } else { scf.yield %prior : buffer }
    %custom_tools = func.call @chat_equal(%key, %custom_tools_key) : (buffer, buffer) -> (i1)
    %tools_in_user = func.call @chat_equal(%key, %tools_in_user_key) : (buffer, buffer) -> (i1)
    %template_kwargs = func.call @chat_equal(%key, %template_kwargs_key) : (buffer, buffer) -> (i1)
    %tool_options = scalar.ori %custom_tools, %tools_in_user : i1
    %template_options = scalar.ori %tool_options, %template_kwargs : i1
    %false = scalar.constant false : i1
    %plain_template = scalar.cmpi eq, %template_options, %false : i1
    func.call @request_check(%plain_template) : (i1)
    %is_model = func.call @chat_equal(%key, %model_key) : (buffer, buffer) -> (i1)
    scf.if %is_model {
      %value = func.call @chat_range(%request, %value_begin, %value_size) : (buffer, i64, i64) -> (buffer)
      %checked = func.call @request_defaults(%value) : (buffer) -> (buffer)
    }
    %is_thinking = func.call @chat_equal(%key, %thinking_key) : (buffer, buffer) -> (i1)
    scf.if %is_thinking {
      %false_type = scalar.constant 5 : i64
      %disabled = scalar.cmpi eq, %value_type, %false_type : i64
      func.call @request_check(%disabled) : (i1)
    }
    scf.yield %next : buffer
  }
  func.return %date : buffer
}

func.def @empty_tools(%tools: buffer) {
  %zero64 = scalar.constant 0 : i64
  %array_type = scalar.constant 3 : i32
  %fields, %type, %count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %array = scalar.cmpi eq, %type, %array_type : i32
  %none = scalar.cmpi eq, %count, %zero64 : i64
  %valid = scalar.andi %array, %none : i1
  func.call @request_check(%valid) : (i1)
  func.return
}

func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  func.call @empty_tools(%tools) : (buffer) -> ()
  %date = func.call @date_value(%request) : (buffer) -> (buffer)
  %bos = global.load @bos : buffer
  %system = global.load @system_prefix : buffer
  %newline = global.load @double_newline : buffer
  %empty = global.load @empty : buffer
  %result = func.call @chat_join(%bos, %system, %date, %newline, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  // System header remains open until the first custom/default system closes.
  %state = scalar.constant 0 : i64
  func.return %result, %state : buffer, i64
}

func.def public @chat_image_limits() -> (i64, i64, i64, i64, i64) {
  %zero = scalar.constant 0 : i64
  func.return %zero, %zero, %zero, %zero, %zero : i64, i64, i64, i64, i64
}

func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %four64 = scalar.constant 4 : i64
  %eight64 = scalar.constant 8 : i64
  %origin = index.constant 0 : offset
  %system_role = global.load @system : buffer
  %user_role = global.load @user : buffer
  %assistant_role = global.load @assistant : buffer
  %system = func.call @chat_equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %user = func.call @chat_equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %assistant = func.call @chat_equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %pending = scalar.cmpi eq, %state, %zero64 : i64
  %first = scalar.cmpi eq, %ordinal, %zero64 : i64
  %custom = scalar.andi %system, %first : i1
  %custom_pending = scalar.andi %custom, %pending : i1
  %ordinary = scalar.ori %user, %assistant : i1
  %known = scalar.ori %custom_pending, %ordinary : i1
  %no_fields = scalar.cmpi eq, %fields, %zero64 : i64
  %valid = scalar.andi %known, %no_fields : i1
  func.call @request_check(%valid) : (i1)
  %text = func.call @chat_trim(%content) : (buffer) -> (buffer)
  %empty = global.load @empty : buffer
  %eot = global.load @eot : buffer
  %rendered = scf.if %custom_pending -> (buffer) {
    %result = func.call @chat_join(%text, %eot, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  } else {
    %before = scf.select %pending, %eot, %empty : buffer
    %open = global.load @header_open : buffer
    %close = global.load @header_close : buffer
    %result = func.call @chat_join(%before, %open, %role, %close, %text, %eot, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  }
  %prior_user = scalar.andi %state, %eight64 : i64
  %user_bit = scf.select %user, %eight64, %zero64 : i64
  %user_seen = scalar.ori %prior_user, %user_bit : i64
  %role_bit0 = scf.select %assistant, %two64, %zero64 : i64
  %role_bit = scf.select %user, %one64, %role_bit0 : i64
  %closed_user = scalar.ori %four64, %user_seen : i64
  %next = scalar.ori %closed_user, %role_bit : i64
  func.return %rendered, %next, %empty : buffer, i64, buffer
}

func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %three = scalar.constant 3 : i64
  %eight = scalar.constant 8 : i64
  %user_bit = scalar.andi %state, %eight : i64
  %has_user = scalar.cmpi ne, %user_bit, %zero : i64
  %role = scalar.andi %state, %three : i64
  %last_user = scalar.cmpi eq, %role, %one : i64
  %valid = scalar.andi %has_user, %last_user : i1
  func.call @request_check(%valid) : (i1)
  %header = global.load @assistant_header : buffer
  func.return %header, %zero : buffer, i64
}

func.def public @parse_tools(%schemas: buffer, %response: buffer) -> (buffer) {
  func.call @empty_tools(%schemas) : (buffer) -> ()
  %empty = global.load @empty_array : buffer
  func.return %empty : buffer
}
func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %no = scalar.constant false : i1
  func.call @request_check(%no) : (i1)
  %empty = global.load @empty : buffer
  %zero = scalar.constant 0 : i64
  func.return %empty, %zero : buffer, i64
}

func.def public @output_next(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %bytes = buffer.length %response
  %end = index.cast %bytes : offset to i64
  %valid = scalar.cmpi ule, %previous, %end : i64
  func.call @request_check(%valid) : (i1)
  %content = scalar.constant 1 : i64
  func.return %content, %previous, %end, %state : i64, i64, i64, i64
}

func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %text = func.call @chat_trim(%content) : (buffer) -> (buffer)
  %empty = global.load @empty : buffer
  %eot = global.load @eot : buffer
  %result = func.call @chat_join(%prompt, %text, %eot, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %reusable = scalar.constant 1 : i32
  func.return %result, %reusable : buffer, i32
}

func.def public @encode_state(%bindings: buffer, %count: i32, %origins: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %bounded_count = scalar.assume %count [range(%count, 1, 16)] : i32
  %length = index.cast %bounded_count : i32 to index
  %records = buffer.view %bindings[%origin] : buffer -> view<16x4xi64>
  %rows = buffer.view %origins[%origin] : buffer -> view<16x4xi64>
  scf.for %i = [%zero to %length step %one] {
    %row_word = view.load %records[%i, 0] : view<16x4xi64> -> i64
    %bounded_row = scalar.assume %row_word [range(%row_word, 0, 15)] : i64
    %row = index.cast %bounded_row : i64 to index
    %read = view.load %records[%i, 1] : view<16x4xi64> -> i64
    %write = view.load %records[%i, 2] : view<16x4xi64> -> i64
    %position = view.load %records[%i, 3] : view<16x4xi64> -> i64
    view.store %read, %rows[%row, 0] : i64, view<16x4xi64>
    view.store %write, %rows[%row, 1] : i64, view<16x4xi64>
    view.store %position, %rows[%row, 3] : i64, view<16x4xi64>
    scf.yield
  }
  func.return
}

func.def public @step(%state: buffer, %initialize: i32, %source_position: i32, %input_count: i32, %residual: hal.buffer, %control: hal.buffer, %native_slot: hal.buffer, %attention: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %state[%origin] : buffer -> view<2xi32>
  %prefill = view.load %view[0] : view<2xi32> -> i32
  %decode = view.load %view[1] : view<2xi32> -> i32
  %stage, %next_source_position = func.call @generation.plan_step(%initialize, %source_position, %input_count, %prefill, %decode) : (i32, i32, i32, i32, i32) -> (i32, i32)
  %completion = func.call @execute_6(%stage, %residual, %control, %native_slot, %attention, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  func.return %completion, %next_source_position : i64, i32
}

func.def @encode_plan(%plan: buffer, %inputs: buffer, %count: index, %first: index, %metadata: buffer, %metadata_origin: offset, %tokens: buffer, %token_origin: offset) -> (i32) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : offset
  %descriptor_base = index.constant 12 : offset
  %selection_base = index.constant 1292 : offset
  %options_base = index.constant 1548 : offset
  %descriptor_origin = index.add %metadata_origin, %descriptor_base : offset
  %selection_origin = index.add %metadata_origin, %selection_base : offset
  %options_origin = index.add %metadata_origin, %options_base : offset
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %descriptors = buffer.view %metadata[%descriptor_origin] : buffer -> view<64x5xi32>
  %selections = buffer.view %metadata[%selection_origin] : buffer -> view<64xi32>
  %options = buffer.view %metadata[%options_origin] : buffer -> view<64x2xi32>
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %absent = scalar.constant -1 : i32
  %bounded_count = index.assume %count [range(%count, 0, 16)] : index
  %token_count, %output_count = scf.for %i = [%zero to %bounded_count step %one](%cursor = %zero32 : i32, %outputs = %zero32 : i32) -> (i32, i32) {
    %record_value = index.add %first, %i : index
    %record = index.assume %record_value [range(%record_value, 0, 31)] : index
    %length = view.load %requests[%record, 0] : view<32x9xi32> -> i32
    %position = view.load %requests[%record, 1] : view<32x9xi32> -> i32
    %row = view.load %requests[%record, 3] : view<32x9xi32> -> i32
    %input_begin = view.load %requests[%record, 4] : view<32x9xi32> -> i32
    %input_count = view.load %requests[%record, 5] : view<32x9xi32> -> i32
    %flags = view.load %requests[%record, 6] : view<32x9xi32> -> i32
    %credit = view.load %requests[%record, 7] : view<32x9xi32> -> i32
    %select_bits = scalar.andi %flags, %one32 : i32
    %selected = scalar.cmpi ne, %select_bits, %zero32 : i32
    %credit_zero = scalar.cmpi eq, %credit, %zero32 : i32
    %propose_bits = scalar.andi %flags, %two32 : i32
    %no_proposal = scalar.cmpi eq, %propose_bits, %zero32 : i32
    %ordinary = scalar.andi %credit_zero, %no_proposal : i1
    func.call @request_check(%ordinary) : (i1)
    %mode = scalar.constant 0 : i32
    %selection = scf.select %selected, %outputs, %absent : i32
    view.store %length, %descriptors[%i, 0] : i32, view<64x5xi32>
    view.store %position, %descriptors[%i, 1] : i32, view<64x5xi32>
    view.store %cursor, %descriptors[%i, 2] : i32, view<64x5xi32>
    view.store %row, %descriptors[%i, 3] : i32, view<64x5xi32>
    view.store %selection, %descriptors[%i, 4] : i32, view<64x5xi32>
    view.store %mode, %options[%i, 0] : i32, view<64x2xi32>
    view.store %credit, %options[%i, 1] : i32, view<64x2xi32>
    %input_index = index.cast %input_begin : i32 to index
    %input_extent = index.cast %input_count : i32 to index
    %cursor_index = index.cast %cursor : i32 to index
    %source_offset = index.scale %input_index, %four : index, offset -> offset
    %input_bytes = index.scale %input_extent, %four : index, offset -> offset
    %cursor_bytes = index.scale %cursor_index, %four : index, offset -> offset
    %target_offset = index.add %token_origin, %cursor_bytes : offset
    buffer.copy %inputs[%source_offset], %tokens[%target_offset], %input_bytes
    %end = scalar.addi %cursor, %length : i32
    %selected_count = scalar.constant 1 : i32
    %active_selections = scf.select %selected, %selected_count, %zero32 : i32
    %bounded_selections = scalar.assume %active_selections [range(%active_selections, 0, 4)] : i32
    %selection_count = index.cast %bounded_selections : i32 to index
    %selection_first = scalar.subi %end, %active_selections : i32
    scf.for %j = [%zero to %selection_count step %one] {
      %j32 = index.cast %j : index to i32
      %slot32 = scalar.addi %outputs, %j32 : i32
      %slot_value = index.cast %slot32 : i32 to index
      %slot = index.assume %slot_value [range(%slot_value, 0, 63)] : index
      %token = scalar.addi %selection_first, %j32 : i32
      view.store %token, %selections[%slot] : i32, view<64xi32>
      scf.yield
    }
    %next_outputs = scalar.addi %outputs, %active_selections : i32
    scf.yield %end, %next_outputs : i32, i32
  }
  %header = buffer.view %metadata[%metadata_origin] : buffer -> view<3xi32>
  %count32 = index.cast %count : index to i32
  view.store %token_count, %header[0] : i32, view<3xi32>
  view.store %count32, %header[1] : i32, view<3xi32>
  view.store %output_count, %header[2] : i32, view<3xi32>
  func.return %output_count : i32
}

func.def public @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32) {
  %zero32 = scalar.constant 0 : i32
  %zero = index.constant 0 : index
  %origin = index.constant 0 : offset
  %no_next = scalar.cmpi eq, %next_count, %zero32 : i32
  %no_first_media = scalar.cmpi eq, %first_media_count, %zero32 : i32
  %no_next_media = scalar.cmpi eq, %next_media_count, %zero32 : i32
  %no_media = scalar.andi %no_first_media, %no_next_media : i1
  %valid = scalar.andi %no_next, %no_media : i1
  func.call @request_check(%valid) : (i1)
  %bytes = buffer.length %tokens
  buffer.fill %zero32, %tokens[%origin], %bytes : i32
  %bounded = scalar.assume %first_count [range(%first_count, 1, 16)] : i32
  %count = index.cast %bounded : i32 to index
  %outputs = func.call @encode_plan(%plan, %inputs, %count, %zero, %metadata, %origin, %tokens, %origin) : (buffer, buffer, index, index, buffer, offset, buffer, offset) -> (i32)
  %eos_origin = index.constant 2060 : offset
  %terminal = buffer.view %metadata[%eos_origin] : buffer -> view<1xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  func.return %outputs : i32
}

func.def public @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative_mask: i32, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer) {
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %eot32 = scalar.constant 128009 : i32
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %no_verified = scalar.cmpi eq, %verified, %zero32 : i32
  %no_next = scalar.cmpi eq, %continues, %zero32 : i32
  %valid = scalar.andi %no_verified, %no_next : i1
  func.call @request_check(%valid) : (i1)
  %bytes = buffer.length %progress
  buffer.fill %zero32, %progress[%origin], %bytes : i32
  %bounded = scalar.assume %count [range(%count, 1, 16)] : i32
  %extent = index.cast %bounded : i32 to index
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %ordinary_ids = buffer.view %ordinary[%origin] : buffer -> view<16xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %cursor = scf.for %i = [%zero to %extent step %one](%cursor = %zero : index) -> (index) {
    %length = view.load %requests[%i, 0] : view<32x9xi32> -> i32
    %source_position = view.load %requests[%i, 2] : view<32x9xi32> -> i32
    %flags = view.load %requests[%i, 6] : view<32x9xi32> -> i32
    %bits = scalar.andi %flags, %one32 : i32
    %selected = scalar.cmpi ne, %bits, %zero32 : i32
    %selected_count = scalar.extui %selected : i1 to i32
    %prior = func.call @generation.accumulate_progress(%progress, %i, %length, %length, %selected_count, %zero32, %source_position) : (buffer, index, i32, i32, i32, i32, i32) -> (index)
    scf.if %selected {
      %slot = index.assume %cursor [range(%cursor, 0, 15)] : index
      %raw_id = view.load %ordinary_ids[%slot] : view<16xi32> -> i32
      %id = func.call @llama32_native_token(%raw_id, %eot32) : (i32, i32) -> (i32)
      %id_bytes = index.constant 4 : offset
      %normalized = buffer.alloca<private> align(4) %id_bytes : buffer
      %normalized_view = buffer.view %normalized[%origin] : buffer -> view<1xi32>
      view.store %id, %normalized_view[0] : i32, view<1xi32>
      func.call @generation.copy_tokens(%normalized, %origin, %one, %progress, %i, %prior) : (buffer, offset, index, buffer, index, index) -> ()
    }
    %advance = index.cast %selected_count : i32 to index
    %next = index.add %cursor, %advance : index
    scf.yield %next : index
  }
  func.return
}

func.def public @epoch(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %first_media_count: i32, %next_media_count: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer, %next_results: hal.buffer) -> (i64) {
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %no_proposal = scalar.cmpi eq, %proposes, %zero : i32
  %no_verify = scalar.cmpi eq, %verifies, %zero : i32
  %single = scalar.cmpi eq, %epoch_count, %one : i32
  %first_text = scalar.cmpi eq, %first_media_count, %zero : i32
  %next_text = scalar.cmpi eq, %next_media_count, %zero : i32
  %ordinary = scalar.andi %no_proposal, %no_verify : i1
  %text = scalar.andi %first_text, %next_text : i1
  %single_text = scalar.andi %single, %text : i1
  %valid = scalar.andi %ordinary, %single_text : i1
  func.call @request_check(%valid) : (i1)
  %stage = scalar.addi %shape, %two : i32
  %completion = func.call @execute_6(%stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %has_output = scalar.cmpi ne, %output_count, %zero : i32
  scf.if %has_output {
    %count = scalar.extui %output_count : i32 to i64
    %word_bytes = scalar.constant 4 : i64
    %origin = scalar.constant 0 : i64
    %length = scalar.muli %count, %word_bytes : i64
    %transfer = func.call @feedback(%zero, %outputs, %origin, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  }
  func.return %completion : i64
}

func.def public @prepare_input(%text: buffer, %media: buffer, %media_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %maximum = scalar.constant 2305843009213693950 : i64
  %text_only = scalar.cmpi eq, %media_count, %zero64 : i64
  %valid_format = scalar.cmpi ule, %format, %one32 : i32
  %valid_boundary = scalar.cmpi ule, %boundary, %two32 : i32
  %valid_capacity = scalar.cmpi ule, %capacity, %maximum : i64
  %modes = scalar.andi %valid_format, %valid_boundary : i1
  %bounds = scalar.andi %text_only, %valid_capacity : i1
  %valid = scalar.andi %modes, %bounds : i1
  func.call @request_check(%valid) : (i1)
  %user = scalar.cmpi eq, %format, %one32 : i32
  %fresh = scalar.cmpi eq, %boundary, %zero32 : i32
  %open = scalar.cmpi eq, %boundary, %one32 : i32
  %empty = global.load @empty : buffer
  %eot = global.load @eot : buffer
  %separator = scf.select %open, %eot, %empty : buffer
  %rendered = scf.if %user -> (buffer) {
    %prefix = scf.if %fresh -> (buffer) {
      %bos = global.load @bos : buffer
      %system = global.load @system_prefix : buffer
      %date = global.load @date : buffer
      %newline = global.load @double_newline : buffer
      %prefix = func.call @chat_join(%bos, %system, %date, %newline, %eot, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %prefix : buffer
    } else { scf.yield %separator : buffer }
    %content = func.call @chat_trim(%text) : (buffer) -> (buffer)
    %user_header = global.load @user_header : buffer
    %assistant_header = global.load @assistant_header : buffer
    %result = func.call @chat_join(%prefix, %user_header, %content, %eot, %assistant_header, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  } else {
    %result = func.call @chat_join(%separator, %text, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  }
  %probe_capacity = scalar.addi %capacity, %one64 : i64
  %tokens, %count = func.call @encode(%rendered, %zero32, %probe_capacity) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  %fits32 = scalar.extui %fits : i1 to i32
  %error = global.load @capacity_error : buffer
  func.call @require(%fits32, %error) : (i32, buffer) -> ()
  func.return %tokens, %count, %empty : buffer, i64, buffer
}
