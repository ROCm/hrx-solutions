        scf.yield %ok, %p, %m, %k, %v, %n : i1, index, offset, offset, offset, i32
      } else { scf.yield %no, %zero, %origin, %origin, %origin, %none : i1, index, offset, offset, offset, i32 }
      %next = scalar.ori %found, %ok : i1
      %np = scf.select %ok, %p, %pos : index
      %nm = scf.select %ok, %m, %mo : offset
      %nk = scf.select %ok, %k, %ko : offset
      %nv = scf.select %ok, %v, %vo : offset
      %nqueries = scf.select %ok, %nq, %queries : i32
