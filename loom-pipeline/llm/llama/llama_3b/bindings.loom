command.program.def public @llama32_project_v_controlled(%layer: index, %token_count: index, %row_origin: index, %count_origin: offset, %kind: index) launch(%parameters: buffer, %packed_input: buffer, %control: buffer, %output: buffer) where [range(%layer, 0, 27), range(%token_count, 1, 2048)] {
  %decode_kind = index.constant 1 : index
  %decode = index.cmp eq, %kind, %decode_kind : index
  %fixed_count = scf.if %decode -> (i32) {
    %one = scalar.constant 1 : i32
    scf.yield %one : i32
  } else {
    %from_view = scalar.constant -1 : i32
    scf.yield %from_view : i32
  }
  %input_size = config.get @llama.model.hidden_size : index
  %output_size = config.get @llama.model.kv_size : index
  %mask = config.get @llama.model.v_down_q6_layers : i32
  %layer32 = index.cast %layer : index to i32
  %one32 = scalar.constant 1 : i32
  %zero32 = scalar.constant 0 : i32
  %bit = scalar.shli %one32, %layer32 : i32
  %selected = scalar.andi %mask, %bit : i32
  %q6 = scalar.cmpi ne, %selected, %zero32 : i32
  %q4_bytes = config.get @llama.model.value_q4_weight_bytes : index
  %q6_bytes = config.get @llama.model.value_q6_weight_bytes : index
  %weight_bytes = scf.select %q6, %q6_bytes, %q4_bytes : index
  %weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%weight_bytes]xi8>
  scf.if %q6 {
    kernel.launch @ggml_linear_q6k_q8_1_x4_compat[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %row_origin, %fixed_count, %count_origin, %control, %packed_input, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
    scf.yield
  } else {
    kernel.launch @ggml_linear_q4k_q8_1_x4_compat[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %row_origin, %fixed_count, %count_origin, %control, %packed_input, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
    scf.yield
  }
  command.return
}

command.program.def public @llama32_project_attention_output_controlled(%layer: index, %token_count: index, %row_origin: index, %count_origin: offset, %kind: index) launch(%parameters: buffer, %packed_input: buffer, %control: buffer, %output: buffer) where [range(%layer, 0, 27), range(%token_count, 1, 2048)] {
  %decode_kind = index.constant 1 : index
  %decode = index.cmp eq, %kind, %decode_kind : index
  %fixed_count = scf.if %decode -> (i32) {
    %one = scalar.constant 1 : i32
    scf.yield %one : i32
  } else {
    %from_view = scalar.constant -1 : i32
    scf.yield %from_view : i32
  }
  %input_size = config.get @llama.model.hidden_size : index
  %output_size = config.get @llama.model.hidden_size : index
  %weight_bytes = config.get @llama.model.attention_output_weight_bytes : index
  %weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%weight_bytes]xi8>
  kernel.launch @ggml_linear_q4k_q8_1_x4_compat[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %row_origin, %fixed_count, %count_origin, %control, %packed_input, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
  command.return
}
