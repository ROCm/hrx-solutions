config.decl @llama.model.hidden_size : index
config.decl @llama.model.key_weight_bytes : index
config.decl @llama.model.kv_size : index
config.decl @llama.model.query_weight_bytes : index
config.decl @llama.model.norm_weight_bytes : index
config.decl @llama.model.rms_epsilon : f32
config.decl @llama.model.v_down_q6_layers : i32
config.decl @llama.model.value_q4_weight_bytes : index
config.decl @llama.model.value_q6_weight_bytes : index
config.decl @llama.model.vocabulary_size : index

