command.program.def public @llama32_project_v(%layer: index, %token_count: index) launch(%parameters: buffer, %packed_input: buffer, %output: buffer) where [range(%layer, 0, 27), range(%token_count, 1, 2048)] {
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  %projection_count = index.cast %token_count : index to i32
  %input_size = config.get @llama.model.hidden_size : index
  %output_size = config.get @llama.model.kv_size : index
  %mask = config.get @llama.model.v_down_q6_layers : i32
  %layer32 = index.cast %layer : index to i32
  %one32 = scalar.constant 1 : i32
  %zero32 = scalar.constant 0 : i32
  %bit = scalar.shli %one32, %layer32 : i32
  %selected = scalar.andi %mask, %bit : i32
  %q6 = scalar.cmpi ne, %selected, %zero32 : i32
  %q4_bytes = config.get @llama.model.value_q4_weight_bytes : index
  %q6_bytes = config.get @llama.model.value_q6_weight_bytes : index
  %weight_bytes = scf.select %q6, %q6_bytes, %q4_bytes : index
  %weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%weight_bytes]xi8>
  scf.if %q6 {
    kernel.launch @ggml_linear_q6k_q8_1_x4_compat[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %projection_row_origin, %projection_count, %projection_count_origin, %packed_input, %packed_input, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
    scf.yield
  } else {
    kernel.launch @ggml_linear_q4k_q8_1_x4_compat[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %projection_row_origin, %projection_count, %projection_count_origin, %packed_input, %packed_input, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
    scf.yield
  }
  command.return
}

