// Llama lookup uses the true-F32 shared Q6 row contract. Qwen's F16-rounded
// row implementation remains separate. This adapter supplies only row geometry,
// valid token bounds and a 256-workitem launch for the shared row computation.
template.decl @llm.token_embedding_q6k_f32.row(%hidden_size: index, %embedding_row_bytes: index, %token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer)

kernel.def export("llama32_token_embedding_q6k_f32") @llama32_token_embedding_q6k_f32(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%token_count0: index, %token_ids: buffer, %weight: buffer, %output: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %hidden_size = config.get @llama.model.hidden_size : index
  %vocabulary = config.get @llama.model.vocabulary_size : index
  %block_values = index.constant 256 : index
  %block_bytes = index.constant 210 : index
  %blocks = index.div %hidden_size, %block_values : index
  %embedding_row_bytes = index.mul %blocks, %block_bytes : index
  %row_value = kernel.workgroup.id<x> : index
  %row = index.assume %row_value [range(%row_value, 0, 2047), lt(%row_value, %token_count)] : index
  %origin = index.constant 0 : offset
  %word_bytes = index.constant 4 : offset
  %row_bytes = index.scale %hidden_size, %word_bytes : index, offset -> offset
  %output_origin = index.scale %row, %row_bytes : index, offset -> offset
  %ids = buffer.view %token_ids[%origin] : buffer -> view<[%token_count]xi32>
  %id32 = view.load %ids[%row] : view<[%token_count]xi32> -> i32
  %id_value = index.cast %id32 : i32 to index
  %id = index.assume %id_value [range(%id_value, 0, 128255), lt(%id_value, %vocabulary)] : index
  %bounded_id = index.cast %id : index to i32
  template.apply<@llm.token_embedding_q6k_f32.row>(%hidden_size, %embedding_row_bytes, %bounded_id, %output_origin, %weight, %output) : (index, index, i32, offset, buffer, buffer)
  kernel.return
}

// T=1 serves decode; a prepared known-input stage passes its explicit T.
command.program.def public @llama32_embedding(%token_count: index) launch(%parameters: buffer, %token_ids: buffer, %residual: buffer) where [range(%token_count, 1, 2048)] {
  %weight_bytes = config.get @llama.model.embedding_weight_bytes : index
  %weight = command.parameter %parameters, "token_embd.weight" : view<[%weight_bytes]xi8>
  kernel.launch @llama32_token_embedding_q6k_f32[%token_count](%token_count, %token_ids, %weight, %residual) : [index](index, buffer, view<[%weight_bytes]xi8>, buffer)
  command.return
}

// The shared row owns weighted RMS arithmetic and its reduction order. The
// model supplies epsilon, width/divisor, row offsets and raw F32 gamma bindings.
// Input, gamma and output must be disjoint, as required by the shared body.
template.decl @llm.rmsnorm.row(%hidden_size0: index, %element_count_f32: f32, %input_row_count: index, %input_row: index, %output_origin: offset, %output_is_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.def export("llama32_rmsnorm_f32") @llama32_rmsnorm_f32(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %token_count, %one) workgroup_size(%threads, %one, %one) : index
} launch(%token_count0: index, %input: buffer, %weight: buffer, %output: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %hidden_size = config.get @llama.model.hidden_size : index
  %width32 = index.cast %hidden_size : index to i32
  %divisor = scalar.uitofp %width32 : i32 to f32
  %epsilon = config.get @llama.model.rms_epsilon : f32
  %row_value = kernel.workgroup.id<y> : index
  %row = index.assume %row_value [range(%row_value, 0, 2047), lt(%row_value, %token_count)] : index
  %word_bytes = index.constant 4 : offset
  %row_bytes = index.scale %hidden_size, %word_bytes : index, offset -> offset
  %output_origin = index.scale %row, %row_bytes : index, offset -> offset
  %half_output = scalar.constant false : i1
  template.apply<@llm.rmsnorm.row>(%hidden_size, %divisor, %token_count, %row, %output_origin, %half_output, %epsilon, %input, %weight, %output) : (index, f32, index, index, offset, i1, f32, buffer, buffer, buffer)
  kernel.return
}

