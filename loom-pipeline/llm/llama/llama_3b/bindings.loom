// Model-owned weight bindings use shared numerical implementations.
// Projection callers supply canonical Q8_1 x4 packed rows and receive F32;
// normalization and embedding use F32 rows. Activation packing, attention,
// residuals, cache/stage policy and sampling belong to consumers.
// Layer/weight encoding is fixed by this exact variant, not a Q4_K_M label.
config.decl @llama.model.attention_output_weight_bytes : index
config.decl @llama.model.embedding_weight_bytes : index
