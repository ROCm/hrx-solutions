// Model-owned active-count adapters; decode count is fixed independently of position.
command.program.def public @llama32_quantize_q8_controlled(%capacity: index, %input_size: index, %row_origin: index, %count_origin: offset, %kind: index) launch(%input: buffer, %control: buffer, %output: buffer) where [range(%capacity, 1, 2048)] {
  %decode_kind = index.constant 1 : index
  %decode = index.cmp eq, %kind, %decode_kind : index
  %fixed_count = scf.if %decode -> (i32) {
    %one = scalar.constant 1 : i32
    scf.yield %one : i32
  } else {
    %from_view = scalar.constant -1 : i32
    scf.yield %from_view : i32
  }
  kernel.launch @ggml_quantize_q8_1_x4_qk_compat_f32[%capacity, %input_size](%capacity, %input_size, %row_origin, %fixed_count, %count_origin, %control, %input, %output) : [index, index](index, index, index, i32, offset, buffer, buffer, buffer)
  command.return
}

