// Every selected tensor retains its canonical checkpoint representation.
// No stage is declared and zero result bytes requests no transformation.
func.def public @prepare_weight(%key: buffer) -> (i64) {
  %bytes = scalar.constant 0 : i64
  func.return %bytes : i64
}
