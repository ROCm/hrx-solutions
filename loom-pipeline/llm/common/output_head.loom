// Shared deterministic output sequence for canonical Q6_K weights.
// Model adapters bind tied/untied weights and normalization. Explicit F32 row
// geometry, packed strides and a static schedule choice own this composition.
// Grouped projection preserves qualified Qwen32/8/m4 cohorts; generic projection
// supports the selected Llama shape without implying arbitrary tuned support.
// T is1..64, H is a full K256 width, and partial-row bytes are ceil(V/4096)*4.
// Normalized input, immutable weights and output IDs are disjoint; logits and
// packing/reduction scratch are transient command-local storage.
kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4_m4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_output_projection_q6k_m8(%vocabulary_size: index) launch(%input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_output_projection_q6k_m32(%vocabulary_size: index) launch(%input: buffer, %weight: buffer, %output: buffer)
