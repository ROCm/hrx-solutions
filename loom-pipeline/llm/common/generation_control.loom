// Common generation accounting uses the native semantic progress contract,
// not a model's control state or verifier result layout. The caller clears the
// destination once, decodes model feedback and supplies each source frontier.
// Return the prior output extent so a caller can append the corresponding IDs.
func.def public @generation.accumulate_progress(%progress: buffer, %row_value: index, %consumed: i32, %known: i32, %outputs: i32, %verifications: i32, %source_position: i32) -> (index) {
  %origin = index.constant 0 : offset
  %row = index.assume %row_value [range(%row_value, 0, 15)] : index
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %prior_consumed = view.load %published[%row, 0] : view<16x21xi32> -> i32
  %prior_known = view.load %published[%row, 1] : view<16x21xi32> -> i32
  %prior_outputs = view.load %published[%row, 2] : view<16x21xi32> -> i32
  %prior_verifications = view.load %published[%row, 3] : view<16x21xi32> -> i32
  %total_consumed = scalar.addi %prior_consumed, %consumed : i32
  %total_known = scalar.addi %prior_known, %known : i32
  %total_outputs = scalar.addi %prior_outputs, %outputs : i32
  %total_verifications = scalar.addi %prior_verifications, %verifications : i32
  %next_source_position = scalar.addi %source_position, %consumed : i32
  view.store %total_consumed, %published[%row, 0] : i32, view<16x21xi32>
  view.store %total_known, %published[%row, 1] : i32, view<16x21xi32>
  view.store %total_outputs, %published[%row, 2] : i32, view<16x21xi32>
  view.store %total_verifications, %published[%row, 3] : i32, view<16x21xi32>
  view.store %next_source_position, %published[%row, 4] : i32, view<16x21xi32>
  %first = index.cast %prior_outputs : i32 to index
  func.return %first : index
}

// Publish a caller-decoded contiguous ID range. Buffer origins and counts are
// explicit; source formats and selected-ID policy remain with the model.
// Both buffers are borrowed for this synchronous, allocation-free transform.
func.def public @generation.copy_tokens(%source: buffer, %source_origin: offset, %count_value: index, %progress: buffer, %row_value: index, %first_value: index) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %five = index.constant 5 : index
  %sixteen = index.constant 16 : index
  %row = index.assume %row_value [range(%row_value, 0, 15)] : index
  %first = index.assume %first_value [range(%first_value, 0, 16)] : index
  %available = index.sub %sixteen, %first : index
  %count = index.assume %count_value [range(%count_value, 0, 16), le(%count_value, %available)] : index
  %tokens = buffer.view %source[%source_origin] : buffer -> view<[%count]xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  scf.for %i = [%zero to %count step %one] {
    %output = index.add %first, %i : index
    %target_value = index.add %output, %five : index
    %target = index.assume %target_value [range(%target_value, 5, 20)] : index
    %token = view.load %tokens[%i] : view<[%count]xi32> -> i32
    view.store %token, %published[%row, %target] : i32, view<16x21xi32>
    scf.yield
  }
  func.return
}

// Plan one greedy known-input/decode step from explicit model-selected stages.
// Selection and source accounting are pure; the model adapter owns state
// decoding, runner arity, borrowed device buffers and completion lifetime.
func.def public @generation.plan_step(%initialize: i32, %source_position: i32, %input_count: i32, %prefill: i32, %decode: i32) -> (i32, i32) {
  %zero = scalar.constant 0 : i32
  %is_prefill = scalar.cmpi ne, %initialize, %zero : i32
  %stage = scf.select %is_prefill, %prefill, %decode : i32
  %next_source_position = scalar.addi %source_position, %input_count : i32
  func.return %stage, %next_source_position : i32, i32
}

