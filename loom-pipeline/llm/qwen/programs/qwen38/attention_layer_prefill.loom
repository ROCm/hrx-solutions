// Qwen full-attention layer over a flat token matrix.
//
// The compile-time token count selects the grid; control[0] supplies the active
// prefix. Zero span capacity uses one row's control position and cache views.
// Nonzero capacity routes each span through its own absolute position and cold
// cache origin, while dense projections still share the packed token matrix.
// Packed spans use verification depth zero.

// Model geometry is supplied by the selected architecture catalog.
// Generic projections bypass the 27B-specific schedules and use Q8 activations.
// Layer masks describe the 24-layer 0.8B checkpoint, not runtime encoding discovery.
config.decl @qwen.model.projection_implementation : index
config.decl @qwen.model.attention_q6_layers : i32
config.decl @qwen.model.query_q5_weight_bytes : index
config.decl @qwen.model.query_q6_weight_bytes : index
config.decl @qwen.model.key_q5_weight_bytes : index
config.decl @qwen.model.key_q6_weight_bytes : index

config.decl @qwen.model.kv_plane_token_bytes : index

config.decl @qwen.model.attention_partial_split_bytes : index
config.decl @qwen.model.attention_width : index
config.decl @qwen.model.ffn_capacity_bytes : index
config.decl @qwen.model.head_size : index
config.decl @qwen.model.hidden_capacity_bytes : index
config.decl @qwen.model.hidden_q8_capacity_bytes : index
config.decl @qwen.model.hidden_size : index
config.decl @qwen.model.key_weight_bytes : index
config.decl @qwen.model.kv_capacity_bytes : index
config.decl @qwen.model.kv_size : index
config.decl @qwen.model.projection_capacity_bytes : index
config.decl @qwen.model.projection_q8_depth4_bytes : index
config.decl @qwen.model.projection_weight_bytes : index
config.decl @qwen.model.query_gate_capacity_bytes : index
config.decl @qwen.model.query_gate_size : index
config.decl @qwen.model.query_weight_bytes : index
config.decl @qwen.model.rms_epsilon : f32
config.decl @qwen.model.value_weight_bytes : index

config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]
config.decl @qwen38.attention.pool_capacity : %value: index where [range(%value, 0, 4194304)]
config.decl @qwen38.attention.decode_split_count : %value: index where [range(%value, 1, 64)]

kernel.decl @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_capacity: index, %input_size_data: index, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q8_0_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_capacity: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4_m4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q6k_f16_wmma_x64(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_c64t32_f32acc(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)



kernel.decl @qwen38_linear_q8_0_f16_wmma_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_rmsnorm_f16_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_capacity: index, %lhs: buffer, %rhs: buffer, %output: buffer)
kernel.decl @qwen38_attention_query_prepare_prefill(%token_count: index) launch(%control: buffer, %epsilon: f32, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer)
kernel.decl @qwen38_attention_kv_prepare_prefill(%token_count: index) launch(%control: buffer, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer)
kernel.decl @qwen38_attention_prefill_f16_wmma(%token_count: index) launch(%control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer)
kernel.decl @qwen38_attention_decode_split_wmma_partial() launch(%token_count: index, %token_ordinal: index, %control_position_index: index, %control: buffer, %query: buffer, %key_cache: buffer, %value_cache: buffer, %partials: buffer)
kernel.decl @qwen38_attention_decode_split_reduce() launch(%token_count: index, %token_ordinal: index, %gate: buffer, %partials: buffer, %output: buffer)

kernel.decl @qwen38_attention_query_prepare_spans(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %epsilon: f32, %projection: buffer, %weight: buffer, %query: buffer, %gate: buffer)
kernel.decl @qwen38_attention_kv_prepare_spans(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %weight: buffer, %state: buffer)
kernel.decl @qwen38_attention_spans_f16_wmma(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %query: buffer, %gate: buffer, %state: buffer, %output: buffer)

command.program.decl @qwen38_ffn_gate_up_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %post_normalized: buffer, %control: buffer, %swiglu: buffer)
command.program.decl @qwen38_ffn_down_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %control: buffer, %swiglu: buffer, %residual: buffer)

command.program.def public @qwen38_attention_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %attention_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%attention_ordinal, 0, 15), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %attention_is_q6 = scf.if %use_generic_quantized_projections -> (i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %attention_is_q6_mask = config.get @qwen.model.attention_q6_layers : i32
    %attention_is_q6_bit = scalar.andi %attention_is_q6_mask, %layer_bit : i32
    %attention_is_q6_selected = scalar.cmpi ne, %attention_is_q6_bit, %zero32 : i32
    scf.yield %attention_is_q6_selected : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  %shape_kv_plane_token_bytes = config.get @qwen.model.kv_plane_token_bytes : index
  %shape_attention_partial_split_bytes = config.get @qwen.model.attention_partial_split_bytes : index
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index
  %shape_head_size = config.get @qwen.model.head_size : index
  %shape_hidden_capacity_bytes = config.get @qwen.model.hidden_capacity_bytes : index
  %shape_hidden_q8_capacity_bytes = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %shape_hidden_size = config.get @qwen.model.hidden_size : index
  %shape_key_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %key_q5_bytes = config.get @qwen.model.key_q5_weight_bytes : index
    %key_q6_bytes = config.get @qwen.model.key_q6_weight_bytes : index
    %key_q56_bytes = scf.select %attention_is_q6, %key_q6_bytes, %key_q5_bytes : index
    scf.yield %key_q56_bytes : index
  } else {
    %key_prepared_bytes = config.get @qwen.model.key_weight_bytes : index
    scf.yield %key_prepared_bytes : index
  }
  %shape_kv_capacity_bytes = config.get @qwen.model.kv_capacity_bytes : index
  %shape_projection_capacity_bytes = config.get @qwen.model.projection_capacity_bytes : index
  %shape_projection_q8_depth4_bytes = config.get @qwen.model.projection_q8_depth4_bytes : index
  %shape_projection_weight_bytes = config.get @qwen.model.projection_weight_bytes : index
  %shape_query_gate_capacity_bytes = config.get @qwen.model.query_gate_capacity_bytes : index
  %shape_query_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %query_q5_bytes = config.get @qwen.model.query_q5_weight_bytes : index
    %query_q6_bytes = config.get @qwen.model.query_q6_weight_bytes : index
    %query_q56_bytes = scf.select %attention_is_q6, %query_q6_bytes, %query_q5_bytes : index
    scf.yield %query_q56_bytes : index
  } else {
    %query_prepared_bytes = config.get @qwen.model.query_weight_bytes : index
    scf.yield %query_prepared_bytes : index
  }
  %shape_value_weight_bytes = config.get @qwen.model.value_weight_bytes : index
  %token_capacity = index.constant 512 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %query_gate_size = config.get @qwen.model.query_gate_size : index
  %key_value_size = config.get @qwen.model.kv_size : index
  %attention_size = config.get @qwen.model.attention_width : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c32 = index.constant 32 : index
  %c4 = index.constant 4 : index
  %c65 = index.constant 65 : index
  %epsilon = config.get @qwen.model.rms_epsilon : f32
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %uses_spans = index.cmp ne, %span_capacity, %c0 : index

  %uses_x64 = index.cmp ult, %schedule_token_count, %c65 : index
  %uses_f32_ffn_input_optimized = scalar.ori %uses_m4, %uses_x64 : i1
  %uses_f32_ffn_input = scalar.ori %uses_f32_ffn_input_optimized, %use_generic_quantized_projections : i1
  %x64_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %uses_c64t32 = index.cmp eq, %schedule_token_count, %c32 : index
  %c64t32_token_count = scf.if %uses_c64t32 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %x128_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %c0 : index
  } else {
    scf.yield %token_count : index
  }
  // Larger token tiles amortize the FFN-down weights for these wide recipes.
  %attention_norm_weight = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%shape_hidden_size]xf32>
  %query_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<[%shape_query_weight_bytes]xi8>
  %query_norm_weight = command.parameter %parameters, "blk.{}.attn_q_norm.weight"[%layer] : view<[%shape_head_size]xf32>
  %key_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<[%shape_key_weight_bytes]xi8>
  %key_norm_weight = command.parameter %parameters, "blk.{}.attn_k_norm.weight"[%layer] : view<[%shape_head_size]xf32>
  %value_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%shape_value_weight_bytes]xi8>
  %output_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%shape_projection_weight_bytes]xi8>
  %post_attention_norm_weight = command.parameter %parameters, "blk.{}.post_attention_norm.weight"[%layer] : view<[%shape_hidden_size]xf32>

  %logical_capacity = config.get @qwen38.attention.cache_capacity : index
  %pool_capacity = config.get @qwen38.attention.pool_capacity : index
  %has_pool = index.cmp ne, %pool_capacity, %c0 : index
  %paged = scalar.andi %uses_spans, %has_pool : i1
  %cache_capacity = scf.select %paged, %pool_capacity, %logical_capacity : index
  %cache_token_bytes = index.cast %shape_kv_plane_token_bytes : index to offset
  %cache_bytes = index.scale %cache_capacity, %cache_token_bytes : index, offset -> offset
  %attention_layer_cache_bytes, %key_cache_offset, %value_cache_offset = buffer.pack [align(256) %cache_bytes, align(256) %cache_bytes] : offset
  %layer_cache_offset = index.scale %attention_ordinal, %attention_layer_cache_bytes : index, offset -> offset
  %layer_key_cache_offset = index.add %layer_cache_offset, %key_cache_offset : offset
  %layer_value_cache_offset = index.add %layer_cache_offset, %value_cache_offset : offset
  %cache_element_count = index.mul %cache_capacity, %key_value_size : index
  %key_cache = buffer.view %attention_cache[%layer_key_cache_offset] : buffer -> view<[%cache_element_count]xf16>
  %value_cache = buffer.view %attention_cache[%layer_value_cache_offset] : buffer -> view<[%cache_element_count]xf16>

  %hidden_bytes = index.cast %shape_hidden_capacity_bytes : index to offset
  %hidden_q8_bytes = index.cast %shape_hidden_q8_capacity_bytes : index to offset
  %query_gate_bytes = index.cast %shape_query_gate_capacity_bytes : index to offset
  %key_value_bytes = index.cast %shape_kv_capacity_bytes : index to offset
  %attention_bytes = index.cast %shape_projection_capacity_bytes : index to offset
  %ffn_bytes = index.cast %shape_ffn_capacity_bytes : index to offset

  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %attention_norm_weight, %normalized) : [index](index, f32, buffer, view<[%shape_hidden_size]xf32>, buffer)
  %query_gate_projection = buffer.alloca<global> align(256) %query_gate_bytes : buffer
  %key_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  %value_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  scf.if %use_generic_quantized_projections {
    %generic_normalized_q8 = buffer.alloca<global> align(256) %hidden_q8_bytes : buffer
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %hidden_size](%token_capacity, %hidden_size, %normalized, %generic_normalized_q8) : [index, index](index, index, buffer, buffer)
    scf.if %attention_is_q6 {
      kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %query_gate_size](%token_capacity, %hidden_size, %query_gate_size, %generic_normalized_q8, %query_weight, %query_gate_projection) : [index, index, index](index, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
    } else {
      kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %query_gate_size](%token_capacity, %hidden_size, %query_gate_size, %generic_normalized_q8, %query_weight, %query_gate_projection) : [index, index, index](index, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
    }
    scf.if %attention_is_q6 {
      kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %key_value_size](%token_capacity, %hidden_size, %key_value_size, %generic_normalized_q8, %key_weight, %key_projection) : [index, index, index](index, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
    } else {
      kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %key_value_size](%token_capacity, %hidden_size, %key_value_size, %generic_normalized_q8, %key_weight, %key_projection) : [index, index, index](index, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
    }
    kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %key_value_size](%token_capacity, %hidden_size, %key_value_size, %generic_normalized_q8, %value_weight, %value_projection) : [index, index, index](index, index, index, buffer, view<[%shape_value_weight_bytes]xi8>, buffer)
  } else {
    scf.if %uses_m4 {
      %normalized_q8 = buffer.alloca<global> align(256) %hidden_q8_bytes : buffer
      kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %hidden_size](%token_capacity, %hidden_size, %normalized, %normalized_q8) : [index, index](index, index, buffer, buffer)
      command.concurrent {
        kernel.launch @ggml_linear_q6k_q8_1_x4_m4[%verification_depth, %hidden_size, %query_gate_size](%verification_depth, %hidden_size, %query_gate_size, %normalized_q8, %query_weight, %query_gate_projection) : [index, index, index](index, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q6k_q8_1_x4_m4[%verification_depth, %hidden_size, %key_value_size](%verification_depth, %hidden_size, %key_value_size, %normalized_q8, %key_weight, %key_projection) : [index, index, index](index, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q8_0_q8_1_x4[%token_count, %hidden_size, %key_value_size](%token_capacity, %hidden_size, %key_value_size, %normalized_q8, %value_weight, %value_projection) : [index, index, index](index, index, index, buffer, view<[%shape_value_weight_bytes]xi8>, buffer)
      }
    } else {
      scf.if %uses_x64 {
        scf.if %uses_c64t32 {
          command.concurrent {
            kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc[%c64t32_token_count, %hidden_size, %query_gate_size](%control, %hidden_size, %query_gate_size, %normalized, %query_weight, %query_gate_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc[%c64t32_token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %value_weight, %value_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_value_weight_bytes]xi8>, buffer)
          }
        } else {
          command.concurrent {
            kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %hidden_size, %query_gate_size](%control, %hidden_size, %query_gate_size, %normalized, %query_weight, %query_gate_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %value_weight, %value_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_value_weight_bytes]xi8>, buffer)
          }
        }
      } else {
        command.concurrent {
          kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_x128[%x128_token_count, %hidden_size, %query_gate_size](%control, %hidden_size, %query_gate_size, %normalized, %query_weight, %query_gate_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_query_weight_bytes]xi8>, buffer)
          kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_x128[%x128_token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_key_weight_bytes]xi8>, buffer)
          kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %value_weight, %value_projection) : [index, index, index](buffer, index, index, buffer, view<[%shape_value_weight_bytes]xi8>, buffer)
        }
      }
    }
  }
  %query = buffer.alloca<global> align(256) %attention_bytes : buffer
  %gate = buffer.alloca<global> align(256) %attention_bytes : buffer
  scf.if %uses_spans {
    command.concurrent {
      kernel.launch @qwen38_attention_query_prepare_spans[%token_count, %span_capacity](%control, %epsilon, %query_gate_projection, %query_norm_weight, %query, %gate) : [index, index](buffer, f32, buffer, view<[%shape_head_size]xf32>, buffer, buffer)
      kernel.launch @qwen38_attention_kv_prepare_spans[%token_count, %span_capacity](%control, %rows, %layer_key_cache_offset, %epsilon, %key_projection, %value_projection, %key_norm_weight, %attention_cache) : [index, index](buffer, buffer, offset, f32, buffer, buffer, view<[%shape_head_size]xf32>, buffer)
    }
    kernel.launch @qwen38_attention_spans_f16_wmma[%token_count, %span_capacity](%control, %rows, %layer_key_cache_offset, %query, %gate, %attention_cache, %attention_output) : [index, index](buffer, buffer, offset, buffer, buffer, buffer, buffer)
  } else {
    command.concurrent {
      kernel.launch @qwen38_attention_query_prepare_prefill[%token_count](%control, %epsilon, %query_gate_projection, %query_norm_weight, %query, %gate) : [index](buffer, f32, buffer, view<[%shape_head_size]xf32>, buffer, buffer)
      kernel.launch @qwen38_attention_kv_prepare_prefill[%token_count](%control, %epsilon, %key_projection, %value_projection, %key_norm_weight, %key_cache, %value_cache) : [index](buffer, f32, buffer, buffer, view<[%shape_head_size]xf32>, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>)
    }

    scf.if %uses_m4 {
      %attention_decode_split_count = config.get @qwen38.attention.decode_split_count : index
      %attention_decode_partial_bytes_per_split = index.cast %shape_attention_partial_split_bytes : index to offset
      %attention_decode_partial_bytes_per_token = index.scale %attention_decode_split_count, %attention_decode_partial_bytes_per_split : index, offset -> offset
      %attention_decode_partial_bytes = index.scale %verification_depth, %attention_decode_partial_bytes_per_token : index, offset -> offset
      %attention_decode_partials = buffer.alloca<global> align(256) %attention_decode_partial_bytes : buffer
      command.concurrent {
        kernel.launch @qwen38_attention_decode_split_wmma_partial(%verification_depth, %c0, %c1, %control, %query, %key_cache, %value_cache, %attention_decode_partials) : (index, index, index, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)
        kernel.launch @qwen38_attention_decode_split_wmma_partial(%verification_depth, %c1, %c1, %control, %query, %key_cache, %value_cache, %attention_decode_partials) : (index, index, index, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)
        kernel.launch @qwen38_attention_decode_split_wmma_partial(%verification_depth, %c2, %c1, %control, %query, %key_cache, %value_cache, %attention_decode_partials) : (index, index, index, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)
        kernel.launch @qwen38_attention_decode_split_wmma_partial(%verification_depth, %c3, %c1, %control, %query, %key_cache, %value_cache, %attention_decode_partials) : (index, index, index, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)
      }
      command.concurrent {
        kernel.launch @qwen38_attention_decode_split_reduce(%verification_depth, %c0, %gate, %attention_decode_partials, %attention_output) : (index, index, buffer, buffer, buffer)
        kernel.launch @qwen38_attention_decode_split_reduce(%verification_depth, %c1, %gate, %attention_decode_partials, %attention_output) : (index, index, buffer, buffer, buffer)
        kernel.launch @qwen38_attention_decode_split_reduce(%verification_depth, %c2, %gate, %attention_decode_partials, %attention_output) : (index, index, buffer, buffer, buffer)
        kernel.launch @qwen38_attention_decode_split_reduce(%verification_depth, %c3, %gate, %attention_decode_partials, %attention_output) : (index, index, buffer, buffer, buffer)
      }
    } else {
      kernel.launch @qwen38_attention_prefill_f16_wmma[%token_count](%control, %query, %gate, %key_cache, %value_cache, %attention_output) : [index](buffer, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)
    }
  }

  %projected_attention = buffer.alloca<global> align(256) %hidden_bytes : buffer
  scf.if %use_generic_quantized_projections {
    %generic_attention_q8 = buffer.alloca<global> align(256) %attention_bytes : buffer
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %attention_size](%token_capacity, %attention_size, %attention_output, %generic_attention_q8) : [index, index](index, index, buffer, buffer)
    kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %attention_size, %hidden_size](%token_capacity, %attention_size, %hidden_size, %generic_attention_q8, %output_weight, %projected_attention) : [index, index, index](index, index, index, buffer, view<[%shape_projection_weight_bytes]xi8>, buffer)
    kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %projected_attention, %residual) : [index](index, buffer, buffer, buffer)
  } else {
    scf.if %uses_m4 {
      %attention_q8_bytes = index.cast %shape_projection_q8_depth4_bytes : index to offset
      %attention_q8 = buffer.alloca<global> align(256) %attention_q8_bytes : buffer
      kernel.launch @ggml_quantize_q8_1_x4_f32[%verification_depth, %attention_size](%verification_depth, %attention_size, %attention_output, %attention_q8) : [index, index](index, index, buffer, buffer)
      kernel.launch @ggml_linear_q6k_q8_1_x4_m4[%verification_depth, %attention_size, %hidden_size](%verification_depth, %attention_size, %hidden_size, %attention_q8, %output_weight, %projected_attention) : [index, index, index](index, index, index, buffer, view<[%shape_projection_weight_bytes]xi8>, buffer)
      kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %projected_attention, %residual) : [index](index, buffer, buffer, buffer)
    } else {
      scf.if %uses_x64 {
        scf.if %uses_c64t32 {
          kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual[%c64t32_token_count, %attention_size, %hidden_size](%control, %attention_size, %hidden_size, %attention_output, %output_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_projection_weight_bytes]xi8>, buffer)
        } else {
          kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %attention_size, %hidden_size](%control, %attention_size, %hidden_size, %attention_output, %output_weight, %projected_attention) : [index, index, index](buffer, index, index, buffer, view<[%shape_projection_weight_bytes]xi8>, buffer)
          kernel.launch @qwen38_residual_add_f32_prefill[%x64_token_count](%token_capacity, %residual, %projected_attention, %residual) : [index](index, buffer, buffer, buffer)
        }
      } else {
        kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_residual_x128[%x128_token_count, %attention_size, %hidden_size](%control, %attention_size, %hidden_size, %attention_output, %output_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_projection_weight_bytes]xi8>, buffer)
      }
    }
  }
  %post_normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  scf.if %uses_f32_ffn_input {
    kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %post_attention_norm_weight, %post_normalized) : [index](index, f32, buffer, view<[%shape_hidden_size]xf32>, buffer)
  } else {
    kernel.launch @qwen38_rmsnorm_f16_prefill[%token_count](%token_capacity, %epsilon, %residual, %post_attention_norm_weight, %post_normalized) : [index](index, f32, buffer, view<[%shape_hidden_size]xf32>, buffer)
  }

  %swiglu = buffer.alloca<global> align(256) %ffn_bytes : buffer
  command.program.launch @qwen38_ffn_gate_up_prefill[%token_count, %schedule_token_count, %layer, %verification_depth, %span_capacity](%parameters, %post_normalized, %control, %swiglu) : [index, index, index, index, index](buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_ffn_down_prefill[%token_count, %schedule_token_count, %layer, %verification_depth, %span_capacity](%parameters, %control, %swiglu, %residual) : [index, index, index, index, index](buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_attention_layer3_prefill(%token_count: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer) where [range(%token_count, 1, 512)] {
  %shape_projection_capacity_bytes = config.get @qwen.model.projection_capacity_bytes : index
  %layer = index.constant 3 : index
  %attention_ordinal = index.constant 0 : index
  %verification_depth = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  %attention_bytes = index.cast %shape_projection_capacity_bytes : index to offset
  %attention_output = buffer.alloca<global> align(256) %attention_bytes : buffer
  command.program.launch @qwen38_attention_layer_prefill[%token_count, %token_count, %layer, %attention_ordinal, %verification_depth, %span_capacity](%parameters, %residual, %attention_cache, %control, %attention_output, %control) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_attention_layer3_prefill_witness(%token_count: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer) where [range(%token_count, 1, 512)] {
  %layer = index.constant 3 : index
  %attention_ordinal = index.constant 0 : index
  %verification_depth = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_attention_layer_prefill[%token_count, %token_count, %layer, %attention_ordinal, %verification_depth, %span_capacity](%parameters, %residual, %attention_cache, %control, %attention_output, %control) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
