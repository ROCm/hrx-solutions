// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.gdn_gate_capture_elements : index
config.decl @qwen.model.gdn_norm_capture_bytes : index
config.decl @qwen.model.gdn_output_capture_bytes : index

config.decl @qwen.model.gdn_capture_qkv_elements : index

config.decl @qwen.model.gdn_gate_span_bytes : index
config.decl @qwen.model.gdn_qkv_capture_bytes : index

config.decl @qwen.model.gdn_capture_span_bytes : index
config.decl @qwen.model.gdn_conv_elements : index
config.decl @qwen.model.gdn_layer_bytes : index
config.decl @qwen.model.gdn_recurrent_bytes : index
config.decl @qwen.model.gdn_value_heads : index
config.decl @qwen.model.group_count : index
config.decl @qwen.model.rms_epsilon : f32

kernel.decl @qwen38_gdn_conv_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer)
kernel.decl @qwen38_gdn_recurrent_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)

// Replays only accepted speculative transitions into their original resident
// state. The capture holds the dense projections; this never repeats the model
// traversal or copies the full recurrent state. Known spans are absent from
// replay, having published in the target traversal. Scratch and captured rows
// retain original_span*4 placement even when acceptance compacts descriptors.
command.program.def public @qwen38_gdn_commit_layer(%span_capacity: index, %layer: index, %ordinal: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 16), range(%layer, 0, 63), range(%ordinal, 0, 47)] {
  %shape_gdn_gate_capture_elements = config.get @qwen.model.gdn_gate_capture_elements : index
  %shape_gdn_norm_capture_bytes = config.get @qwen.model.gdn_norm_capture_bytes : index
  %shape_gdn_output_capture_bytes = config.get @qwen.model.gdn_output_capture_bytes : index
  %shape_gdn_capture_qkv_elements = config.get @qwen.model.gdn_capture_qkv_elements : index
  %shape_gdn_gate_span_bytes = config.get @qwen.model.gdn_gate_span_bytes : index
  %shape_gdn_qkv_capture_bytes = config.get @qwen.model.gdn_qkv_capture_bytes : index
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %shape_gdn_conv_elements = config.get @qwen.model.gdn_conv_elements : index

  %shape_gdn_layer_bytes = config.get @qwen.model.gdn_layer_bytes : index
  %shape_gdn_recurrent_bytes = config.get @qwen.model.gdn_recurrent_bytes : index
  %shape_gdn_value_heads = config.get @qwen.model.gdn_value_heads : index
  %span_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %qkv_span_bytes = index.cast %shape_gdn_qkv_capture_bytes : index to offset
  %gate_span_bytes = index.cast %shape_gdn_gate_span_bytes : index to offset
  %layer_bytes = index.scale %span_capacity, %span_bytes : index, offset -> offset
  %alpha_offset = index.scale %span_capacity, %qkv_span_bytes : index, offset -> offset
  %gate_bytes = index.scale %span_capacity, %gate_span_bytes : index, offset -> offset
  %beta_offset = index.add %alpha_offset, %gate_bytes : offset
  %origin = index.scale %ordinal, %layer_bytes : index, offset -> offset
  %alpha_origin = index.add %origin, %alpha_offset : offset
  %beta_origin = index.add %origin, %beta_offset : offset
  %qkv = buffer.view %capture[%origin] : buffer -> view<[%span_capacity]x[%shape_gdn_capture_qkv_elements]xf32>
  %alpha = buffer.view %capture[%alpha_origin] : buffer -> view<[%span_capacity]x[%shape_gdn_gate_capture_elements]xf32>
  %beta = buffer.view %capture[%beta_origin] : buffer -> view<[%span_capacity]x[%shape_gdn_gate_capture_elements]xf32>
  %state_layer_bytes = index.cast %shape_gdn_layer_bytes : index to offset
  %history_offset = index.cast %shape_gdn_recurrent_bytes : index to offset
  %state_origin = index.scale %ordinal, %state_layer_bytes : index, offset -> offset
  %history_origin = index.add %state_origin, %history_offset : offset
  %conv_weight = command.parameter %parameters, "blk.{}.ssm_conv1d.weight"[%layer] : view<[%shape_gdn_conv_elements]xf32>
  %a = command.parameter %parameters, "blk.{}.ssm_a"[%layer] : view<[%shape_gdn_value_heads]xf32>
  %bias = command.parameter %parameters, "blk.{}.ssm_dt.bias"[%layer] : view<[%shape_gdn_value_heads]xf32>
  %qkv_bytes = index.scale %span_capacity, %qkv_span_bytes : index, offset -> offset
  %norm_span_bytes = index.cast %shape_gdn_norm_capture_bytes : index to offset
  %output_span_bytes = index.cast %shape_gdn_output_capture_bytes : index to offset
  %norm_bytes = index.scale %span_capacity, %norm_span_bytes : index, offset -> offset
  %output_bytes = index.scale %span_capacity, %output_span_bytes : index, offset -> offset
  %qkv_silu = buffer.alloca<global> align(256) %qkv_bytes : buffer
  %inverse_norm = buffer.alloca<global> align(256) %norm_bytes : buffer
  %output = buffer.alloca<global> align(256) %output_bytes : buffer
  %epsilon = config.get @qwen.model.rms_epsilon : f32
  kernel.launch @qwen38_gdn_conv_spans[%span_capacity](%replay, %rows, %history_origin, %epsilon, %qkv, %conv_weight, %state, %qkv_silu, %inverse_norm) : [index](buffer, buffer, offset, f32, view<[%span_capacity]x[%shape_gdn_capture_qkv_elements]xf32>, view<[%shape_gdn_conv_elements]xf32>, buffer, buffer, buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%span_capacity](%replay, %rows, %state_origin, %qkv_silu, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, view<[%span_capacity]x[%shape_gdn_gate_capture_elements]xf32>, view<[%span_capacity]x[%shape_gdn_gate_capture_elements]xf32>, view<[%shape_gdn_value_heads]xf32>, view<[%shape_gdn_value_heads]xf32>, buffer, buffer)
  command.return
}

command.program.def public @qwen38_gdn_commit(%span_capacity: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 16)] {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %groups = config.get @qwen.model.group_count : index
  scf.for %group = [%zero to %groups step %one] unroll {
    %layer0 = index.mul %group, %four : index
    %layer1 = index.add %layer0, %one : index
    %layer2 = index.add %layer0, %two : index
    %ordinal0 = index.mul %group, %three : index
    %ordinal1 = index.add %ordinal0, %one : index
    %ordinal2 = index.add %ordinal0, %two : index
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %layer0, %ordinal0](%parameters, %capture, %replay, %rows, %state) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %layer1, %ordinal1](%parameters, %capture, %replay, %rows, %state) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %layer2, %ordinal2](%parameters, %capture, %replay, %rows, %state) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}
