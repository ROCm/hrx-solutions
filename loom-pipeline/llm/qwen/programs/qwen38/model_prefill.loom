// Qwen3.8-27B base-model prefill body.
//
// Four schedule-specialized command programs cover every prompt length through
// 512 tokens. Each remains reusable for the dynamic token counts in its range.
// Sixteen fixed architectural groups each advance three Gated DeltaNet layers
// followed by one full-attention layer. Preparation unrolls this model
// structure, specializes every parameter and state ordinal, and aliases the
// nested layer allocations into one transient root.

// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.gdn_capture_span_bytes : index
config.decl @qwen.model.group_count : index
config.decl @qwen.model.hidden_row_bytes : index
config.decl @qwen.model.projection_capacity_bytes : index

command.program.decl @qwen38_gdn_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %gdn_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %gdn_state: buffer, %control: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 63), range(%gdn_ordinal, 0, 47), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)]

command.program.decl @qwen38_attention_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %attention_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%attention_ordinal, 0, 15), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)]

command.program.decl @qwen38_output_head_prefill_greedy_with_hidden() launch(%parameters: buffer, %residual: buffer, %control: buffer, %normalized: buffer, %token_id: buffer)

kernel.decl @qwen38_prefill_finish_control() launch(%control: buffer, %token_ids: buffer, %progress: buffer)

// Advances the complete base-model body over the packed token matrix. With
// span_capacity zero, control describes one causal span and rows is unused.
// Otherwise control is an epoch and rows supplies stable resident origins.
// Dense math and layer order are identical; only stateful dispatches change.
command.program.decl @qwen38_embedding_prefill(%token_count: index) launch(%parameters: buffer, %token_ids: buffer, %residual: buffer)

command.program.def public @qwen38_text_prefill_body_impl(%token_count: index, %schedule_token_count: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %shape_projection_capacity_bytes = config.get @qwen.model.projection_capacity_bytes : index
  %group_begin = index.constant 0 : index
  %group_end = config.get @qwen.model.group_count : index
  %group_step = index.constant 1 : index
  %layers_per_group = index.constant 4 : index
  %gdn_layers_per_group = index.constant 3 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index

  // Full-attention layers reuse one maximum-capacity output. Nested layer
  // allocations remain semantic and are packed with it during preparation.
  %attention_bytes = index.cast %shape_projection_capacity_bytes : index to offset
  %attention_output = buffer.alloca<global> align(256) %attention_bytes : buffer

  scf.for %group = [%group_begin to %group_end step %group_step] unroll {
    %layer0 = index.mul %group, %layers_per_group : index
    %layer1 = index.add %layer0, %c1 : index
    %layer2 = index.add %layer0, %c2 : index
    %attention_layer = index.add %layer0, %c3 : index

    %gdn_ordinal0 = index.mul %group, %gdn_layers_per_group : index
    %gdn_ordinal1 = index.add %gdn_ordinal0, %c1 : index
    %gdn_ordinal2 = index.add %gdn_ordinal0, %c2 : index

    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer0, %gdn_ordinal0, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer1, %gdn_ordinal1, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer2, %gdn_ordinal2, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_attention_layer_prefill[%token_count, %schedule_token_count, %attention_layer, %group, %verification_depth, %span_capacity](%parameters, %residual, %attention_cache, %control, %attention_output, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}

// Ordinary prefill specializes transition capture away. The small semantic
// allocation keeps the internal body ABI uniform and is removed with its only
// uses before command-program allocation planning.
command.program.def public @qwen38_text_prefill_body(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 1, 512)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Schedule roots keep kernel selection static while retaining dynamic indirect
// workgroup counts within each reusable command buffer. The caller selects the
// narrowest schedule covering its runtime token count.
command.program.def public @qwen38_text_prefill_body_schedule_c64t32(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 1, 32)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %schedule_token_count = index.constant 32 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_text_prefill_body_schedule_x64(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 1, 64)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %schedule_token_count = index.constant 64 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
