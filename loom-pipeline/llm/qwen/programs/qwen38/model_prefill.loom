command.program.def public @qwen38_text_prefill_body_schedule_c128(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 481, 512)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %schedule_token_count = index.constant 512 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Embeds one prompt span, advances every base-model layer, and publishes the
// first greedy continuation token plus the final normalized hidden row.
command.program.def @qwen38_text_prefill_transition(%token_count: index, %schedule_token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %normalized_hidden: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  command.program.launch @qwen38_embedding_prefill[%token_count](%parameters, %token_ids, %residual) : [index](buffer, buffer, buffer)
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_output_head_prefill_greedy_with_hidden[](%parameters, %residual, %control, %normalized_hidden, %token_ids) : [](buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_prefill_finish_control(%control, %token_ids, %progress) : (buffer, buffer, buffer)
  command.return
}

// Advances one non-final prompt chunk without sampling or changing the
// prefill control ABI. The same materialized root can be replayed for every
// complete 512-token chunk while persistent GDN and attention state carry
// across executions.
command.program.def public @qwen38_text_prefill_chunk(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %token_ids: buffer) where [range(%token_count, 1, 512)] {
  %shape_gdn_capture_span_bytes = config.get @qwen.model.gdn_capture_span_bytes : index
  %schedule_token_count = index.constant 512 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.cast %shape_gdn_capture_span_bytes : index to offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  command.program.launch @qwen38_embedding_prefill[%token_count](%parameters, %token_ids, %residual) : [index](buffer, buffer, buffer)
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Prefills one token span and hands its persistent state directly to ordinary
// decode while keeping the normalized hidden row internal.
command.program.def public @qwen38_text_prefill_greedy(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512)] {
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %hidden_bytes = index.cast %shape_hidden_row_bytes : index to offset
  %normalized_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @qwen38_text_prefill_transition[%token_count, %token_count](%parameters, %residual, %control, %gdn_state, %attention_cache, %normalized_hidden, %token_ids, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Prefills one token span while exposing the final normalized target hidden row
// consumed by the first NextN/MTP proposal step. Schedule wrappers fix the
// algorithm family while token count remains an issue-time launch input.
command.program.def @qwen38_text_prefill_greedy_with_hidden_impl(%token_count: index, %schedule_token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %normalized_hidden: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512)] {
  command.program.launch @qwen38_text_prefill_transition[%token_count, %schedule_token_count](%parameters, %residual, %control, %gdn_state, %attention_cache, %normalized_hidden, %token_ids, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

