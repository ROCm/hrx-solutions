// Static FFN projection implementations for the shipped catalogs. Residency and schedules
// remain architecture choices; these helpers do not discover tensor encodings.
// projection_implementation: 0 retains the 27B prepared/optimized schedules; 1 uses
// the existing generic Q4/Q5/Q6 contractions with Q8 activation packing.

config.decl @qwen.model.projection_implementation : index
config.decl @qwen.model.ffn_gate_q4_layers : i32
config.decl @qwen.model.ffn_gate_q6_layers : i32
config.decl @qwen.model.ffn_down_q6_layers : i32
config.decl @qwen.model.ffn_gate_q4_weight_bytes : index
config.decl @qwen.model.ffn_gate_q5_weight_bytes : index
config.decl @qwen.model.ffn_gate_q6_weight_bytes : index
config.decl @qwen.model.ffn_down_q5_weight_bytes : index
config.decl @qwen.model.ffn_down_q6_weight_bytes : index
config.decl @qwen.model.ffn_down_weight_bytes : index
config.decl @qwen.model.ffn_gate_weight_bytes : index
config.decl @qwen.model.ffn_row_bytes : index
config.decl @qwen.model.ffn_size : index
config.decl @qwen.model.hidden_row_bytes : index
config.decl @qwen.model.hidden_size : index
config.decl @qwen.model.ffn_capacity_bytes : index
config.decl @qwen.model.hidden_capacity_bytes : index
config.decl @qwen.model.hidden_q8_capacity_bytes : index
config.decl @qwen.model.hidden_q8_depth4_bytes : index

// Tensor names and per-layer encoding policy stay in the model adapter.
template.decl @llm.ffn.gate_up_decode(%hidden_size: index, %ffn_size: index, %use_generic_quantized_projections: i1, %use_mmvq_compat: i1, %ffn_gate_is_q4: i1, %ffn_gate_is_q6: i1, %shape_ffn_gate_weight_bytes: index, %shape_ffn_row_bytes: index, %ffn_gate_weight: view<[%shape_ffn_gate_weight_bytes]xi8>, %ffn_up_weight: view<[%shape_ffn_gate_weight_bytes]xi8>, %post_normalized_q8: buffer, %swiglu: buffer)
template.decl @llm.ffn.down_decode(%hidden_size: index, %ffn_size: index, %use_generic_quantized_projections: i1, %use_mmvq_compat: i1, %ffn_down_is_q4: i1, %ffn_down_is_q6: i1, %shape_ffn_down_weight_bytes: index, %shape_ffn_row_bytes: index, %shape_hidden_row_bytes: index, %ffn_down_weight: view<[%shape_ffn_down_weight_bytes]xi8>, %swiglu: buffer, %residual: buffer)
template.decl @llm.ffn.gate_up_prefill(%hidden_size: index, %ffn_size: index, %use_generic_quantized_projections: i1, %use_mmvq_compat: i1, %ffn_gate_is_q4: i1, %ffn_gate_is_q6: i1, %token_count: index, %token_capacity: index, %schedule_token_count: index, %projection_row_origin: index, %projection_count_origin: offset, %uses_m4: i1, %m4_token_count: index, %shape_ffn_capacity_bytes: index, %shape_ffn_gate_weight_bytes: index, %shape_hidden_q8_capacity_bytes: index, %shape_hidden_q8_depth4_bytes: index, %ffn_gate_weight: view<[%shape_ffn_gate_weight_bytes]xi8>, %ffn_up_weight: view<[%shape_ffn_gate_weight_bytes]xi8>, %post_normalized: buffer, %control: buffer, %swiglu: buffer)
template.decl @llm.ffn.down_prefill(%hidden_size: index, %ffn_size: index, %use_generic_quantized_projections: i1, %use_mmvq_compat: i1, %ffn_down_is_q4: i1, %ffn_down_is_q6: i1, %token_count: index, %token_capacity: index, %schedule_token_count: index, %projection_row_origin: index, %projection_count_origin: offset, %uses_m4: i1, %m4_token_count: index, %shape_ffn_capacity_bytes: index, %shape_ffn_down_weight_bytes: index, %shape_hidden_capacity_bytes: index, %ffn_down_weight: view<[%shape_ffn_down_weight_bytes]xi8>, %control: buffer, %swiglu: buffer, %residual: buffer)

command.program.def public @qwen38_ffn_gate_up_decode(%layer: index) launch(%parameters: buffer, %post_normalized_q8: buffer, %swiglu: buffer) where [range(%layer, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_gate_is_q4, %ffn_gate_is_q6 = scf.if %use_generic_quantized_projections -> (i1, i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_gate_is_q4_mask = config.get @qwen.model.ffn_gate_q4_layers : i32
    %ffn_gate_is_q4_bit = scalar.andi %ffn_gate_is_q4_mask, %layer_bit : i32
    %ffn_gate_is_q4_selected = scalar.cmpi ne, %ffn_gate_is_q4_bit, %zero32 : i32
    %ffn_gate_is_q6_mask = config.get @qwen.model.ffn_gate_q6_layers : i32
    %ffn_gate_is_q6_bit = scalar.andi %ffn_gate_is_q6_mask, %layer_bit : i32
    %ffn_gate_is_q6_selected = scalar.cmpi ne, %ffn_gate_is_q6_bit, %zero32 : i32
    scf.yield %ffn_gate_is_q4_selected, %ffn_gate_is_q6_selected : i1, i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no, %no : i1, i1
  }
  %shape_ffn_gate_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_gate_q4_bytes = config.get @qwen.model.ffn_gate_q4_weight_bytes : index
    %ffn_gate_q5_bytes = config.get @qwen.model.ffn_gate_q5_weight_bytes : index
    %ffn_gate_q6_bytes = config.get @qwen.model.ffn_gate_q6_weight_bytes : index
    %ffn_gate_q56_bytes = scf.select %ffn_gate_is_q6, %ffn_gate_q6_bytes, %ffn_gate_q5_bytes : index
    %ffn_gate_selected_bytes = scf.select %ffn_gate_is_q4, %ffn_gate_q4_bytes, %ffn_gate_q56_bytes : index
    scf.yield %ffn_gate_selected_bytes : index
  } else {
    %ffn_gate_prepared_bytes = config.get @qwen.model.ffn_gate_weight_bytes : index
    scf.yield %ffn_gate_prepared_bytes : index
  }
  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %mmvq_compat = scalar.constant false : i1
  template.apply<@llm.ffn.gate_up_decode>(%hidden_size, %ffn_size, %use_generic_quantized_projections, %mmvq_compat, %ffn_gate_is_q4, %ffn_gate_is_q6, %shape_ffn_gate_weight_bytes, %shape_ffn_row_bytes, %ffn_gate_weight, %ffn_up_weight, %post_normalized_q8, %swiglu) : (index, index, i1, i1, i1, i1, index, index, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer, buffer)
  command.return
}

command.program.def public @qwen38_ffn_down_decode(%layer: index) launch(%parameters: buffer, %swiglu: buffer, %residual: buffer) where [range(%layer, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_down_is_q6 = scf.if %use_generic_quantized_projections -> (i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_down_is_q6_mask = config.get @qwen.model.ffn_down_q6_layers : i32
    %ffn_down_is_q6_bit = scalar.andi %ffn_down_is_q6_mask, %layer_bit : i32
    %ffn_down_is_q6_selected = scalar.cmpi ne, %ffn_down_is_q6_bit, %zero32 : i32
    scf.yield %ffn_down_is_q6_selected : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  %shape_ffn_down_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_down_q5_bytes = config.get @qwen.model.ffn_down_q5_weight_bytes : index
    %ffn_down_q6_bytes = config.get @qwen.model.ffn_down_q6_weight_bytes : index
    %ffn_down_q56_bytes = scf.select %ffn_down_is_q6, %ffn_down_q6_bytes, %ffn_down_q5_bytes : index
    scf.yield %ffn_down_q56_bytes : index
  } else {
    %ffn_down_prepared_bytes = config.get @qwen.model.ffn_down_weight_bytes : index
    scf.yield %ffn_down_prepared_bytes : index
  }
  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%shape_ffn_down_weight_bytes]xi8>
  %ffn_down_is_q4 = scalar.constant false : i1
  %mmvq_compat = scalar.constant false : i1
  template.apply<@llm.ffn.down_decode>(%hidden_size, %ffn_size, %use_generic_quantized_projections, %mmvq_compat, %ffn_down_is_q4, %ffn_down_is_q6, %shape_ffn_down_weight_bytes, %shape_ffn_row_bytes, %shape_hidden_row_bytes, %ffn_down_weight, %swiglu, %residual) : (index, index, i1, i1, i1, i1, index, index, index, view<[%shape_ffn_down_weight_bytes]xi8>, buffer, buffer)
  command.return
}

command.program.def public @qwen38_ffn_gate_up_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %post_normalized: buffer, %control: buffer, %swiglu: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_gate_is_q4, %ffn_gate_is_q6 = scf.if %use_generic_quantized_projections -> (i1, i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_gate_is_q4_mask = config.get @qwen.model.ffn_gate_q4_layers : i32
    %ffn_gate_is_q4_bit = scalar.andi %ffn_gate_is_q4_mask, %layer_bit : i32
    %ffn_gate_is_q4_selected = scalar.cmpi ne, %ffn_gate_is_q4_bit, %zero32 : i32
    %ffn_gate_is_q6_mask = config.get @qwen.model.ffn_gate_q6_layers : i32
    %ffn_gate_is_q6_bit = scalar.andi %ffn_gate_is_q6_mask, %layer_bit : i32
    %ffn_gate_is_q6_selected = scalar.cmpi ne, %ffn_gate_is_q6_bit, %zero32 : i32
    scf.yield %ffn_gate_is_q4_selected, %ffn_gate_is_q6_selected : i1, i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no, %no : i1, i1
  }
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index
  %shape_ffn_gate_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_gate_q4_bytes = config.get @qwen.model.ffn_gate_q4_weight_bytes : index
    %ffn_gate_q5_bytes = config.get @qwen.model.ffn_gate_q5_weight_bytes : index
    %ffn_gate_q6_bytes = config.get @qwen.model.ffn_gate_q6_weight_bytes : index
    %ffn_gate_q56_bytes = scf.select %ffn_gate_is_q6, %ffn_gate_q6_bytes, %ffn_gate_q5_bytes : index
    %ffn_gate_selected_bytes = scf.select %ffn_gate_is_q4, %ffn_gate_q4_bytes, %ffn_gate_q56_bytes : index
    scf.yield %ffn_gate_selected_bytes : index
  } else {
    %ffn_gate_prepared_bytes = config.get @qwen.model.ffn_gate_weight_bytes : index
    scf.yield %ffn_gate_prepared_bytes : index
  }
  %shape_hidden_q8_capacity_bytes = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %shape_hidden_q8_depth4_bytes = config.get @qwen.model.hidden_q8_depth4_bytes : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %token_capacity = index.constant 512 : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %mmvq_compat = scalar.constant false : i1
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  template.apply<@llm.ffn.gate_up_prefill>(%hidden_size, %ffn_size, %use_generic_quantized_projections, %mmvq_compat, %ffn_gate_is_q4, %ffn_gate_is_q6, %token_count, %token_capacity, %schedule_token_count, %projection_row_origin, %projection_count_origin, %uses_m4, %verification_depth, %shape_ffn_capacity_bytes, %shape_ffn_gate_weight_bytes, %shape_hidden_q8_capacity_bytes, %shape_hidden_q8_depth4_bytes, %ffn_gate_weight, %ffn_up_weight, %post_normalized, %control, %swiglu) : (index, index, i1, i1, i1, i1, index, index, index, index, offset, i1, index, index, index, index, index, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_ffn_down_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %control: buffer, %swiglu: buffer, %residual: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_down_is_q6 = scf.if %use_generic_quantized_projections -> (i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_down_is_q6_mask = config.get @qwen.model.ffn_down_q6_layers : i32
    %ffn_down_is_q6_bit = scalar.andi %ffn_down_is_q6_mask, %layer_bit : i32
    %ffn_down_is_q6_selected = scalar.cmpi ne, %ffn_down_is_q6_bit, %zero32 : i32
    scf.yield %ffn_down_is_q6_selected : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index
  %shape_ffn_down_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_down_q5_bytes = config.get @qwen.model.ffn_down_q5_weight_bytes : index
    %ffn_down_q6_bytes = config.get @qwen.model.ffn_down_q6_weight_bytes : index
    %ffn_down_q56_bytes = scf.select %ffn_down_is_q6, %ffn_down_q6_bytes, %ffn_down_q5_bytes : index
    scf.yield %ffn_down_q56_bytes : index
  } else {
    %ffn_down_prepared_bytes = config.get @qwen.model.ffn_down_weight_bytes : index
    scf.yield %ffn_down_prepared_bytes : index
  }
  %shape_hidden_capacity_bytes = config.get @qwen.model.hidden_capacity_bytes : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %token_capacity = index.constant 512 : index
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%shape_ffn_down_weight_bytes]xi8>
  %ffn_down_is_q4 = scalar.constant false : i1
  %mmvq_compat = scalar.constant false : i1
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  template.apply<@llm.ffn.down_prefill>(%hidden_size, %ffn_size, %use_generic_quantized_projections, %mmvq_compat, %ffn_down_is_q4, %ffn_down_is_q6, %token_count, %token_capacity, %schedule_token_count, %projection_row_origin, %projection_count_origin, %uses_m4, %verification_depth, %shape_ffn_capacity_bytes, %shape_ffn_down_weight_bytes, %shape_hidden_capacity_bytes, %ffn_down_weight, %control, %swiglu, %residual) : (index, index, i1, i1, i1, i1, index, index, index, index, offset, i1, index, index, index, index, view<[%shape_ffn_down_weight_bytes]xi8>, buffer, buffer, buffer)
  command.return
}
