// Static FFN projection implementations for the shipped catalogs. Residency and schedules
// remain architecture choices; these helpers do not discover tensor encodings.
// projection_implementation: 0 retains the 27B prepared/optimized schedules; 1 uses
// the existing generic Q4/Q5/Q6 contractions with Q8 activation packing.

config.decl @qwen.model.projection_implementation : index
config.decl @qwen.model.ffn_gate_q4_layers : i32
config.decl @qwen.model.ffn_gate_q6_layers : i32
config.decl @qwen.model.ffn_down_q6_layers : i32
config.decl @qwen.model.ffn_gate_q4_weight_bytes : index
config.decl @qwen.model.ffn_gate_q5_weight_bytes : index
config.decl @qwen.model.ffn_gate_q6_weight_bytes : index
config.decl @qwen.model.ffn_down_q5_weight_bytes : index
config.decl @qwen.model.ffn_down_q6_weight_bytes : index
config.decl @qwen.model.ffn_down_weight_bytes : index
config.decl @qwen.model.ffn_gate_weight_bytes : index
config.decl @qwen.model.ffn_row_bytes : index
config.decl @qwen.model.ffn_size : index
config.decl @qwen.model.hidden_row_bytes : index
config.decl @qwen.model.hidden_size : index
config.decl @qwen.model.ffn_capacity_bytes : index
config.decl @qwen.model.hidden_capacity_bytes : index
config.decl @qwen.model.hidden_q8_capacity_bytes : index
config.decl @qwen.model.hidden_q8_depth4_bytes : index

kernel.decl @ggml_linear_q4k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4_channel8(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_f32_decode(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_residual_add_f32_decode() launch(%lhs: buffer, %rhs: buffer, %output: buffer)
kernel.decl @qwen38_swiglu_f32_decode() launch(%gate: buffer, %up: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4_m4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4_m4_channel8(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_f32_decode_m4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_channel8(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_c64t32_f32acc(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_channel8(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_ffn_gate_up_q5k_f16_wmma_block_prefetch(%token_count: index) launch(%control: buffer, %input: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer)
kernel.decl @qwen38_ffn_gate_up_q5k_f16_wmma_block_prefetch_channel8(%token_count: index) launch(%control: buffer, %input: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_x64(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_c64t32_f32acc(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_c128_t128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_x128_input_f16(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_c128_t128_input_f16(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_residual_c128_t256_input_f16(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %residual: buffer)
kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_capacity: index, %lhs: buffer, %rhs: buffer, %output: buffer)
kernel.decl @qwen38_swiglu_f32_prefill(%token_count: index) launch(%token_capacity: index, %gate: buffer, %up: buffer, %output: buffer)

// Decode gate/up consumes Q8-packed normalized activations and produces F32 SwiGLU.
command.program.def public @qwen38_ffn_gate_up_decode(%layer: index) launch(%parameters: buffer, %post_normalized_q8: buffer, %swiglu: buffer) where [range(%layer, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_gate_is_q4, %ffn_gate_is_q6 = scf.if %use_generic_quantized_projections -> (i1, i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_gate_is_q4_mask = config.get @qwen.model.ffn_gate_q4_layers : i32
    %ffn_gate_is_q4_bit = scalar.andi %ffn_gate_is_q4_mask, %layer_bit : i32
    %ffn_gate_is_q4_selected = scalar.cmpi ne, %ffn_gate_is_q4_bit, %zero32 : i32
    %ffn_gate_is_q6_mask = config.get @qwen.model.ffn_gate_q6_layers : i32
    %ffn_gate_is_q6_bit = scalar.andi %ffn_gate_is_q6_mask, %layer_bit : i32
    %ffn_gate_is_q6_selected = scalar.cmpi ne, %ffn_gate_is_q6_bit, %zero32 : i32
    scf.yield %ffn_gate_is_q4_selected, %ffn_gate_is_q6_selected : i1, i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no, %no : i1, i1
  }
  %shape_ffn_gate_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_gate_q4_bytes = config.get @qwen.model.ffn_gate_q4_weight_bytes : index
    %ffn_gate_q5_bytes = config.get @qwen.model.ffn_gate_q5_weight_bytes : index
    %ffn_gate_q6_bytes = config.get @qwen.model.ffn_gate_q6_weight_bytes : index
    %ffn_gate_q56_bytes = scf.select %ffn_gate_is_q6, %ffn_gate_q6_bytes, %ffn_gate_q5_bytes : index
    %ffn_gate_selected_bytes = scf.select %ffn_gate_is_q4, %ffn_gate_q4_bytes, %ffn_gate_q56_bytes : index
    scf.yield %ffn_gate_selected_bytes : index
  } else {
    %ffn_gate_prepared_bytes = config.get @qwen.model.ffn_gate_weight_bytes : index
    scf.yield %ffn_gate_prepared_bytes : index
  }
  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %token_count = index.constant 1 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_bytes = index.cast %shape_ffn_row_bytes : index to offset
  %ffn_gate = buffer.alloca<global> align(256) %ffn_bytes : buffer
  %ffn_up = buffer.alloca<global> align(256) %ffn_bytes : buffer
  scf.if %use_generic_quantized_projections {
    scf.if %ffn_gate_is_q4 {
      kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
    } else {
      scf.if %ffn_gate_is_q6 {
        kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      } else {
        kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      }
    }
  } else {
    command.concurrent {
      kernel.launch @ggml_linear_q5k_q8_1_x4_channel8[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      kernel.launch @ggml_linear_q5k_q8_1_x4_channel8[%token_count, %hidden_size, %ffn_size](%token_count, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
    }
  }
  kernel.launch @qwen38_swiglu_f32_decode(%ffn_gate, %ffn_up, %swiglu) : (buffer, buffer, buffer)
  command.return
}

// Decode down consumes F32 SwiGLU and adds the projected result to the residual.
command.program.def public @qwen38_ffn_down_decode(%layer: index) launch(%parameters: buffer, %swiglu: buffer, %residual: buffer) where [range(%layer, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_down_is_q6 = scf.if %use_generic_quantized_projections -> (i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_down_is_q6_mask = config.get @qwen.model.ffn_down_q6_layers : i32
    %ffn_down_is_q6_bit = scalar.andi %ffn_down_is_q6_mask, %layer_bit : i32
    %ffn_down_is_q6_selected = scalar.cmpi ne, %ffn_down_is_q6_bit, %zero32 : i32
    scf.yield %ffn_down_is_q6_selected : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  %shape_ffn_down_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_down_q5_bytes = config.get @qwen.model.ffn_down_q5_weight_bytes : index
    %ffn_down_q6_bytes = config.get @qwen.model.ffn_down_q6_weight_bytes : index
    %ffn_down_q56_bytes = scf.select %ffn_down_is_q6, %ffn_down_q6_bytes, %ffn_down_q5_bytes : index
    scf.yield %ffn_down_q56_bytes : index
  } else {
    %ffn_down_prepared_bytes = config.get @qwen.model.ffn_down_weight_bytes : index
    scf.yield %ffn_down_prepared_bytes : index
  }
  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %token_count = index.constant 1 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%shape_ffn_down_weight_bytes]xi8>
  %hidden_bytes = index.cast %shape_hidden_row_bytes : index to offset
  %ffn_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  scf.if %use_generic_quantized_projections {
    %swiglu_q8_bytes = index.cast %shape_ffn_row_bytes : index to offset
    %swiglu_q8 = buffer.alloca<global> align(256) %swiglu_q8_bytes : buffer
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %ffn_size](%token_count, %ffn_size, %swiglu, %swiglu_q8) : [index, index](index, index, buffer, buffer)
    scf.if %ffn_down_is_q6 {
      kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
    } else {
      kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
    }
  } else {
    kernel.launch @ggml_linear_q6k_f32_decode[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
  }
  kernel.launch @qwen38_residual_add_f32_decode(%residual, %ffn_output, %residual) : (buffer, buffer, buffer)
  command.return
}

// Prefill input/output precision follows the existing schedule: generic and
// narrow/MTP paths use F32; the wide 27B fused path consumes/produces F16.
// control retains the caller's active-token-count buffer.
command.program.def public @qwen38_ffn_gate_up_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %post_normalized: buffer, %control: buffer, %swiglu: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_gate_is_q4, %ffn_gate_is_q6 = scf.if %use_generic_quantized_projections -> (i1, i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_gate_is_q4_mask = config.get @qwen.model.ffn_gate_q4_layers : i32
    %ffn_gate_is_q4_bit = scalar.andi %ffn_gate_is_q4_mask, %layer_bit : i32
    %ffn_gate_is_q4_selected = scalar.cmpi ne, %ffn_gate_is_q4_bit, %zero32 : i32
    %ffn_gate_is_q6_mask = config.get @qwen.model.ffn_gate_q6_layers : i32
    %ffn_gate_is_q6_bit = scalar.andi %ffn_gate_is_q6_mask, %layer_bit : i32
    %ffn_gate_is_q6_selected = scalar.cmpi ne, %ffn_gate_is_q6_bit, %zero32 : i32
    scf.yield %ffn_gate_is_q4_selected, %ffn_gate_is_q6_selected : i1, i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no, %no : i1, i1
  }
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index
  %shape_ffn_gate_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_gate_q4_bytes = config.get @qwen.model.ffn_gate_q4_weight_bytes : index
    %ffn_gate_q5_bytes = config.get @qwen.model.ffn_gate_q5_weight_bytes : index
    %ffn_gate_q6_bytes = config.get @qwen.model.ffn_gate_q6_weight_bytes : index
    %ffn_gate_q56_bytes = scf.select %ffn_gate_is_q6, %ffn_gate_q6_bytes, %ffn_gate_q5_bytes : index
    %ffn_gate_selected_bytes = scf.select %ffn_gate_is_q4, %ffn_gate_q4_bytes, %ffn_gate_q56_bytes : index
    scf.yield %ffn_gate_selected_bytes : index
  } else {
    %ffn_gate_prepared_bytes = config.get @qwen.model.ffn_gate_weight_bytes : index
    scf.yield %ffn_gate_prepared_bytes : index
  }
  %shape_hidden_q8_capacity_bytes = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %shape_hidden_q8_depth4_bytes = config.get @qwen.model.hidden_q8_depth4_bytes : index
  %token_capacity = index.constant 512 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %c0 = index.constant 0 : index
  %c32 = index.constant 32 : index
  %c4 = index.constant 4 : index
  %c65 = index.constant 65 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %uses_x64 = index.cmp ult, %schedule_token_count, %c65 : index
  %x64_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %uses_c64t32 = index.cmp eq, %schedule_token_count, %c32 : index
  %c64t32_token_count = scf.if %uses_c64t32 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %x128_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %c0 : index
  } else {
    scf.yield %token_count : index
  }
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %hidden_q8_bytes = index.cast %shape_hidden_q8_capacity_bytes : index to offset
  %ffn_bytes = index.cast %shape_ffn_capacity_bytes : index to offset
  %ffn_gate = buffer.alloca<global> align(256) %ffn_bytes : buffer
  %ffn_up = buffer.alloca<global> align(256) %ffn_bytes : buffer
  scf.if %use_generic_quantized_projections {
    %generic_normalized_q8 = buffer.alloca<global> align(256) %hidden_q8_bytes : buffer
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %hidden_size](%token_capacity, %hidden_size, %post_normalized, %generic_normalized_q8) : [index, index](index, index, buffer, buffer)
    scf.if %ffn_gate_is_q4 {
      kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
    } else {
      scf.if %ffn_gate_is_q6 {
        kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      } else {
        kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %ffn_size](%token_capacity, %hidden_size, %ffn_size, %generic_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      }
    }
  } else {
    scf.if %uses_m4 {
      %post_normalized_q8_bytes = index.cast %shape_hidden_q8_depth4_bytes : index to offset
      %post_normalized_q8 = buffer.alloca<global> align(256) %post_normalized_q8_bytes : buffer
      kernel.launch @ggml_quantize_q8_1_x4_f32[%verification_depth, %hidden_size](%verification_depth, %hidden_size, %post_normalized, %post_normalized_q8) : [index, index](index, index, buffer, buffer)
      command.concurrent {
        kernel.launch @ggml_linear_q5k_q8_1_x4_m4_channel8[%verification_depth, %hidden_size, %ffn_size](%verification_depth, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_gate_weight, %ffn_gate) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
        kernel.launch @ggml_linear_q5k_q8_1_x4_m4_channel8[%verification_depth, %hidden_size, %ffn_size](%verification_depth, %hidden_size, %ffn_size, %post_normalized_q8, %ffn_up_weight, %ffn_up) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      }
    } else {
      scf.if %uses_x64 {
        scf.if %uses_c64t32 {
          command.concurrent {
            kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_channel8[%c64t32_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_gate_weight, %ffn_gate) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_channel8[%c64t32_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_up_weight, %ffn_up) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
          }
        } else {
          command.concurrent {
            kernel.launch @qwen38_linear_q5k_f16_wmma_channel8[%x64_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_gate_weight, %ffn_gate) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
            kernel.launch @qwen38_linear_q5k_f16_wmma_channel8[%x64_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_up_weight, %ffn_up) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
          }
        }
      } else {
        kernel.launch @qwen38_ffn_gate_up_q5k_f16_wmma_block_prefetch_channel8[%x128_token_count](%control, %post_normalized, %ffn_gate_weight, %ffn_up_weight, %swiglu) : [index](buffer, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer)
      }
    }
  }
  scf.if %use_generic_quantized_projections {
    kernel.launch @qwen38_swiglu_f32_prefill[%token_count](%token_capacity, %ffn_gate, %ffn_up, %swiglu) : [index](index, buffer, buffer, buffer)
  } else {
    scf.if %uses_x64 {
      scf.if %uses_c64t32 {
        kernel.launch @qwen38_swiglu_f32_prefill[%c64t32_token_count](%token_capacity, %ffn_gate, %ffn_up, %swiglu) : [index](index, buffer, buffer, buffer)
      } else {
        kernel.launch @qwen38_swiglu_f32_prefill[%x64_token_count](%token_capacity, %ffn_gate, %ffn_up, %swiglu) : [index](index, buffer, buffer, buffer)
      }
    }
  }
  command.return
}

// Prefill down consumes that schedule's SwiGLU format and publishes the residual.
command.program.def public @qwen38_ffn_down_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %control: buffer, %swiglu: buffer, %residual: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %ffn_down_is_q6 = scf.if %use_generic_quantized_projections -> (i1) {
    %layer32 = index.cast %layer : index to i32
    %one32 = scalar.constant 1 : i32
    %zero32 = scalar.constant 0 : i32
    %layer_bit = scalar.shli %one32, %layer32 : i32
    %ffn_down_is_q6_mask = config.get @qwen.model.ffn_down_q6_layers : i32
    %ffn_down_is_q6_bit = scalar.andi %ffn_down_is_q6_mask, %layer_bit : i32
    %ffn_down_is_q6_selected = scalar.cmpi ne, %ffn_down_is_q6_bit, %zero32 : i32
    scf.yield %ffn_down_is_q6_selected : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index
  %shape_ffn_down_weight_bytes = scf.if %use_generic_quantized_projections -> (index) {
    %ffn_down_q5_bytes = config.get @qwen.model.ffn_down_q5_weight_bytes : index
    %ffn_down_q6_bytes = config.get @qwen.model.ffn_down_q6_weight_bytes : index
    %ffn_down_q56_bytes = scf.select %ffn_down_is_q6, %ffn_down_q6_bytes, %ffn_down_q5_bytes : index
    scf.yield %ffn_down_q56_bytes : index
  } else {
    %ffn_down_prepared_bytes = config.get @qwen.model.ffn_down_weight_bytes : index
    scf.yield %ffn_down_prepared_bytes : index
  }
  %shape_hidden_capacity_bytes = config.get @qwen.model.hidden_capacity_bytes : index
  %token_capacity = index.constant 512 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %c0 = index.constant 0 : index
  %c32 = index.constant 32 : index
  %c4 = index.constant 4 : index
  %c65 = index.constant 65 : index
  %c481 = index.constant 481 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %uses_x64 = index.cmp ult, %schedule_token_count, %c65 : index
  %x64_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %uses_c64t32 = index.cmp eq, %schedule_token_count, %c32 : index
  %c64t32_token_count = scf.if %uses_c64t32 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %uses_ffn_down_c128 = index.cmp uge, %schedule_token_count, %c481 : index
  %schedule_is_256 = index.cmp eq, %schedule_token_count, %c256 : index
  %schedule_is_512 = index.cmp eq, %schedule_token_count, %c512 : index
  %uses_ffn_down_t256 = scalar.ori %schedule_is_256, %schedule_is_512 : i1
  %ffn_down_t256_token_count = scf.if %uses_ffn_down_t256 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %ffn_down_x128_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %c0 : index
  } else {
    %selected_token_count = scf.if %uses_ffn_down_c128 -> (index) {
      scf.yield %c0 : index
    } else {
      scf.yield %token_count : index
    }
    scf.yield %selected_token_count : index
  }
  %ffn_down_c128_token_count = scf.if %uses_ffn_down_c128 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%shape_ffn_down_weight_bytes]xi8>
  %hidden_bytes = index.cast %shape_hidden_capacity_bytes : index to offset
  %ffn_bytes = index.cast %shape_ffn_capacity_bytes : index to offset
  %ffn_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  scf.if %use_generic_quantized_projections {
    %generic_swiglu_q8 = buffer.alloca<global> align(256) %ffn_bytes : buffer
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %ffn_size](%token_capacity, %ffn_size, %swiglu, %generic_swiglu_q8) : [index, index](index, index, buffer, buffer)
    scf.if %ffn_down_is_q6 {
      kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_capacity, %ffn_size, %hidden_size, %generic_swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
    } else {
      kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_capacity, %ffn_size, %hidden_size, %generic_swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
    }
    kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %ffn_output, %residual) : [index](index, buffer, buffer, buffer)
  } else {
    scf.if %uses_m4 {
      kernel.launch @ggml_linear_q6k_f32_decode_m4[%verification_depth, %ffn_size, %hidden_size](%verification_depth, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
      kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %ffn_output, %residual) : [index](index, buffer, buffer, buffer)
    } else {
      scf.if %uses_x64 {
        scf.if %uses_c64t32 {
          kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual[%c64t32_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
        } else {
          kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %ffn_output) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
          kernel.launch @qwen38_residual_add_f32_prefill[%x64_token_count](%token_capacity, %residual, %ffn_output, %residual) : [index](index, buffer, buffer, buffer)
        }
      } else {
        scf.if %uses_ffn_down_t256 {
          kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_residual_c128_t256_input_f16[%ffn_down_t256_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
        } else {
          scf.if %uses_ffn_down_c128 {
            kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_residual_c128_t128_input_f16[%ffn_down_c128_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
          } else {
            kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_residual_x128_input_f16[%ffn_down_x128_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
          }
        }
      }
    }
  }
  command.return
}
