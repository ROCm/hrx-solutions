// All mixed Q4_K/Q5_K/Q6_K tensors retain checkpoint byte order in residency.
// No declared stage and zero result bytes means no transformation.

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %bytes = scalar.constant 0 : i64
  func.return %bytes : i64
}
