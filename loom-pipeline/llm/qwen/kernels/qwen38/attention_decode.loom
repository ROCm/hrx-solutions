template.decl @llm.attention.head_rms_value(%raw: f32, %head_divisor: f32, %epsilon: f32, %lane: index, %head_size: index, %norm_weight: buffer) -> (f32)

template.decl @llm.attention.decode_f32(%query_heads: index, %key_heads: index, %head_size: index, %query_width: index, %cache_width: index, %cache_capacity: index, %attention_scale: f32, %position_i32: i32, %head0: index, %lane0: index, %has_gate: i1, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer)

// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.head_scratch_bytes : index

config.decl @qwen.model.head_gate_size : index

config.decl @qwen.model.attention_heads : index
config.decl @qwen.model.attention_scale : f32
config.decl @qwen.model.attention_width : index
config.decl @qwen.model.head_divisor : f32
config.decl @qwen.model.head_size : index
config.decl @qwen.model.kv_heads : index
config.decl @qwen.model.kv_size : index
config.decl @qwen.model.query_gate_size : index

template.decl @qwen38.attention.rope_text_value(%position: i32, %lane0: index, %normalized_head: buffer) -> (f32)

// Qwen3.8-27B token-one full-attention primitives. The model projects Q and
// its sigmoid gate together as 24 adjacent [query, gate] head pairs, while K
// and V use four 256-wide heads.

config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]

// Normalizes and rotates 24 query heads while extracting their colocated
// sigmoid gates. One workgroup owns one complete 256-wide head.
kernel.def export("qwen38_attention_query_prepare_decode") @qwen38_attention_query_prepare_decode() {
  %unit = index.constant 1 : index
  %head_count = config.get @qwen.model.attention_heads : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %control: buffer, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer) {
  %shape_attention_width = config.get @qwen.model.attention_width : index
  %shape_head_size = config.get @qwen.model.head_size : index
  %shape_query_gate_size = config.get @qwen.model.query_gate_size : index
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 23)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %c0_offset = index.constant 0 : offset
  %c256 = config.get @qwen.model.head_size : index
  %c512 = config.get @qwen.model.head_gate_size : index
  %projection_view = buffer.view %query_gate_projection[%c0_offset] : buffer -> view<[%shape_query_gate_size]xf32>
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<1xi32>
  %query_view = buffer.view %query[%c0_offset] : buffer -> view<[%shape_attention_width]xf32>
  %gate_view = buffer.view %gate[%c0_offset] : buffer -> view<[%shape_attention_width]xf32>
  %head_projection_base = index.mul %head, %c512 : index
  %query_index = index.add %head_projection_base, %lane : index
  %gate_head_base = index.add %head_projection_base, %c256 : index
  %gate_index = index.add %gate_head_base, %lane : index
  %output_head_base = index.mul %head, %c256 : index
  %output_index = index.add %output_head_base, %lane : index
  %raw_query = view.load %projection_view[%query_index] : view<[%shape_query_gate_size]xf32> -> f32
  %raw_gate = view.load %projection_view[%gate_index] : view<[%shape_query_gate_size]xf32> -> f32
  %head_size_f32 = config.get @qwen.model.head_divisor : f32
  %normalized = template.apply<@llm.attention.head_rms_value>(%raw_query, %head_size_f32, %epsilon, %lane, %shape_head_size, %norm_weight) : (f32, f32, f32, index, index, buffer) -> (f32)
  %shape_head_scratch_bytes = config.get @qwen.model.head_scratch_bytes : index
  %scratch_bytes = index.cast %shape_head_scratch_bytes : index to offset
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<[%shape_head_size]xf32>
  view.store %normalized, %scratch_view[%lane] : f32, view<[%shape_head_size]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %position = view.load %control_view[0] : view<1xi32> -> i32
  %rotated = template.apply<@qwen38.attention.rope_text_value>(%position, %lane, %scratch) : (i32, index, buffer) -> (f32)
  %gate_value = scalar.logisticf<afn> %raw_gate : f32
  view.store %rotated, %query_view[%output_index] : f32, view<[%shape_attention_width]xf32>
  view.store %gate_value, %gate_view[%output_index] : f32, view<[%shape_attention_width]xf32>
  kernel.return
}

// Normalizes and rotates the four key heads, then publishes K and V directly
// into the session cache at the dynamic token position.
kernel.def export("qwen38_attention_kv_prepare_decode") @qwen38_attention_kv_prepare_decode() {
  %unit = index.constant 1 : index
  %head_count = config.get @qwen.model.kv_heads : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %control: buffer, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer) {
  %shape_head_size = config.get @qwen.model.head_size : index
  %shape_kv_size = config.get @qwen.model.kv_size : index
  %cache_capacity = config.get @qwen38.attention.cache_capacity : index
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 3)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %c0_offset = index.constant 0 : offset
  %c256 = config.get @qwen.model.head_size : index
  %c1024 = config.get @qwen.model.kv_size : index
  %key_projection_view = buffer.view %key_projection[%c0_offset] : buffer -> view<[%shape_kv_size]xf32>
  %value_projection_view = buffer.view %value_projection[%c0_offset] : buffer -> view<[%shape_kv_size]xf32>
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<1xi32>
  %cache_element_count = index.mul %cache_capacity, %c1024 : index
  %key_cache_view = buffer.view %key_cache[%c0_offset] : buffer -> view<[%cache_element_count]xf16>
  %value_cache_view = buffer.view %value_cache[%c0_offset] : buffer -> view<[%cache_element_count]xf16>
  %head_base = index.mul %head, %c256 : index
  %projection_index = index.add %head_base, %lane : index
  %raw_key = view.load %key_projection_view[%projection_index] : view<[%shape_kv_size]xf32> -> f32
  %raw_value = view.load %value_projection_view[%projection_index] : view<[%shape_kv_size]xf32> -> f32
  %head_size_f32 = config.get @qwen.model.head_divisor : f32
  %normalized = template.apply<@llm.attention.head_rms_value>(%raw_key, %head_size_f32, %epsilon, %lane, %shape_head_size, %norm_weight) : (f32, f32, f32, index, index, buffer) -> (f32)
  %shape_head_scratch_bytes = config.get @qwen.model.head_scratch_bytes : index
  %scratch_bytes = index.cast %shape_head_scratch_bytes : index to offset
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<[%shape_head_size]xf32>
  view.store %normalized, %scratch_view[%lane] : f32, view<[%shape_head_size]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %position_i32 = view.load %control_view[0] : view<1xi32> -> i32
  %position0 = index.cast %position_i32 : i32 to index
  %position = index.assume %position0 [range(%position0, 0, 262143), lt(%position0, %cache_capacity)] : index
  %rotated = template.apply<@qwen38.attention.rope_text_value>(%position_i32, %lane, %scratch) : (i32, index, buffer) -> (f32)
  %token_cache_base = index.mul %position, %c1024 : index
  %cache_head_base = index.add %token_cache_base, %head_base : index
  %cache_index = index.add %cache_head_base, %lane : index
  %key_f16 = scalar.fptrunc %rotated : f32 to f16
  %value_f16 = scalar.fptrunc %raw_value : f32 to f16
  view.store %key_f16, %key_cache_view[%cache_index] : f16, view<[%cache_element_count]xf16>
  view.store %value_f16, %value_cache_view[%cache_index] : f16, view<[%cache_element_count]xf16>
  kernel.return
}

// Computes grouped-query decode attention with an online softmax. Each
// workgroup owns one query head and keeps one output component per lane live
// while traversing the dynamic visible cache prefix.
kernel.def export("qwen38_attention_decode") @qwen38_attention_decode() {
  %unit = index.constant 1 : index
  %head_count = config.get @qwen.model.attention_heads : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer) {
  %shape_attention_width = config.get @qwen.model.attention_width : index
  %cache_capacity = config.get @qwen38.attention.cache_capacity : index
  %query_heads = config.get @qwen.model.attention_heads : index
  %key_heads = config.get @qwen.model.kv_heads : index
  %c256 = config.get @qwen.model.head_size : index
  %c1024 = config.get @qwen.model.kv_size : index
  %attention_scale = config.get @qwen.model.attention_scale : f32
  %head0 = kernel.workgroup.id<x> : index
  %lane0 = kernel.workitem.id<x> : index
  %c0_offset = index.constant 0 : offset
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<1xi32>
  %position_i32 = view.load %control_view[0] : view<1xi32> -> i32
  %has_gate = scalar.constant true : i1
  template.apply<@llm.attention.decode_f32>(%query_heads, %key_heads, %c256, %shape_attention_width, %c1024, %cache_capacity, %attention_scale, %position_i32, %head0, %lane0, %has_gate, %query, %gate, %key_cache, %value_cache, %output) : (index, index, index, index, index, index, f32, i32, index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

check.case public @qwen38_attention_decode_known_case {
  %shape_attention_width = config.get @qwen.model.attention_width : index
  %shape_head_size = config.get @qwen.model.head_size : index
  %shape_kv_size = config.get @qwen.model.kv_size : index
  %shape_query_gate_size = config.get @qwen.model.query_gate_size : index
  %epsilon = check.literal value(0.000001) : f32
  %control = check.generate.fill value(0) : tensor<1xi32>
  %query_gate_projection = check.generate.fill value(2.0) : tensor<[%shape_query_gate_size]xf32>
  %key_projection = check.generate.fill value(2.0) : tensor<[%shape_kv_size]xf32>
  %value_projection = check.generate.fill value(0.25) : tensor<[%shape_kv_size]xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<[%shape_head_size]xf32>
  %query = check.generate.fill value(0.0) : tensor<[%shape_attention_width]xf32>
  %gate = check.generate.fill value(0.0) : tensor<[%shape_attention_width]xf32>
  %key_cache = check.generate.fill value(0.0) : tensor<[%shape_kv_size]xf16>
  %value_cache = check.generate.fill value(0.0) : tensor<[%shape_kv_size]xf16>
  %output = check.generate.fill value(0.0) : tensor<[%shape_attention_width]xf32>
  %expected_query = check.generate.fill value(0.49999994) : tensor<[%shape_attention_width]xf32>
  %expected_gate = check.generate.fill value(0.8807970779778823) : tensor<[%shape_attention_width]xf32>
  %expected_key = check.generate.fill value(0.5) : tensor<[%shape_kv_size]xf16>
  %expected_value = check.generate.fill value(0.25) : tensor<[%shape_kv_size]xf16>
  %expected_output = check.generate.fill value(0.22019926949447058) : tensor<[%shape_attention_width]xf32>
  kernel.launch @qwen38_attention_query_prepare_decode(%epsilon, %control, %query_gate_projection, %norm_weight, %query, %gate) : (f32, tensor<1xi32>, tensor<[%shape_query_gate_size]xf32>, tensor<[%shape_head_size]xf32>, tensor<[%shape_attention_width]xf32>, tensor<[%shape_attention_width]xf32>)
  kernel.launch @qwen38_attention_kv_prepare_decode(%epsilon, %control, %key_projection, %value_projection, %norm_weight, %key_cache, %value_cache) : (f32, tensor<1xi32>, tensor<[%shape_kv_size]xf32>, tensor<[%shape_kv_size]xf32>, tensor<[%shape_head_size]xf32>, tensor<[%shape_kv_size]xf16>, tensor<[%shape_kv_size]xf16>)
  kernel.launch @qwen38_attention_decode(%control, %query, %gate, %key_cache, %value_cache, %output) : (tensor<1xi32>, tensor<[%shape_attention_width]xf32>, tensor<[%shape_attention_width]xf32>, tensor<[%shape_kv_size]xf16>, tensor<[%shape_kv_size]xf16>, tensor<[%shape_attention_width]xf32>)
  check.expect.close actual(%query) expected(%expected_query) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_attention_width]xf32>
  check.expect.close actual(%gate) expected(%expected_gate) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_attention_width]xf32>
  check.expect.close actual(%key_cache) expected(%expected_key) atol(0.0009765625) rtol(0.000001) nan(same) : tensor<[%shape_kv_size]xf16>
  check.expect.close actual(%value_cache) expected(%expected_value) atol(0.0) rtol(0.0) nan(same) : tensor<[%shape_kv_size]xf16>
  check.expect.close actual(%output) expected(%expected_output) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_attention_width]xf32>
  check.return
}

check.benchmark<@qwen38_attention_decode_known_case> @qwen38_attention_decode_benchmark
