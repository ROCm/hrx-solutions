// Row-parallel Qwen3.8 prefill primitives. Token count is an issue-time
// workload value; fixed row widths preserve exact launch geometry and let one
// compiled entry cover every prefill length through 512.

// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.ffn_size : index

config.decl @qwen.model.hidden_divisor : f32
config.decl @qwen.model.hidden_size : index

template.decl @llm.rmsnorm.row(%hidden_size0: index, %element_count_f32: f32, %input_row_count: index, %input_row: index, %output_origin: offset, %output_is_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
template.decl @llm.residual_add_f32.row(%hidden_size0: index, %row_count0: index, %row0: index, %lhs: buffer, %rhs: buffer, %output: buffer)
template.decl @llm.swiglu_f32.row(%ffn_size0: index, %row_count0: index, %row0: index, %gate: buffer, %up: buffer, %output: buffer)

kernel.def export("qwen38_rmsnorm_f32_prefill") @qwen38_rmsnorm_f32_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %divisor = config.get @qwen.model.hidden_divisor : f32
  %element_bytes = index.constant 4 : offset
  %row_bytes = index.scale %hidden_size, %element_bytes : index, offset -> offset
  %output_origin = index.scale %token, %row_bytes : index, offset -> offset
  %output_is_f16 = scalar.constant false : i1
  template.apply<@llm.rmsnorm.row>(%hidden_size, %divisor, %bounded_token_count, %token, %output_origin, %output_is_f16, %epsilon, %input, %weight, %output) : (index, f32, index, index, offset, i1, f32, buffer, buffer, buffer)
  kernel.return
}

// Produces the same F16 values consumed by WMMA projections without
// materializing and repeatedly reloading an F32 normalized tensor.
kernel.def export("qwen38_rmsnorm_f16_prefill") @qwen38_rmsnorm_f16_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %divisor = config.get @qwen.model.hidden_divisor : f32
  %element_bytes = index.constant 2 : offset
  %row_bytes = index.scale %hidden_size, %element_bytes : index, offset -> offset
  %output_origin = index.scale %token, %row_bytes : index, offset -> offset
  %output_is_f16 = scalar.constant true : i1
  template.apply<@llm.rmsnorm.row>(%hidden_size, %divisor, %bounded_token_count, %token, %output_origin, %output_is_f16, %epsilon, %input, %weight, %output) : (index, f32, index, index, offset, i1, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_residual_add_f32_prefill") @qwen38_residual_add_f32_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 0, 512)] : index
  %unit = index.constant 1 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %channels_per_group = index.constant 1024 : index
  %bounded_hidden_size = index.assume %hidden_size [range(%hidden_size, 1024, 32768), multiple_of(%hidden_size, 1024)] : index
  %workgroup_count = index.div %bounded_hidden_size, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %hidden_size = config.get @qwen.model.hidden_size : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  template.apply<@llm.residual_add_f32.row>(%hidden_size, %bounded_token_count, %token, %lhs, %rhs, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_swiglu_f32_prefill") @qwen38_swiglu_f32_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 0, 512)] : index
  %unit = index.constant 1 : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %channels_per_group = index.constant 256 : index
  %bounded_ffn_size = index.assume %ffn_size [range(%ffn_size, 256, 32768), multiple_of(%ffn_size, 256)] : index
  %workgroup_count = index.div %bounded_ffn_size, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %gate: buffer, %up: buffer, %output: buffer) {
  %ffn_size = config.get @qwen.model.ffn_size : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  template.apply<@llm.swiglu_f32.row>(%ffn_size, %bounded_token_count, %token, %gate, %up, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

// Existing case name covers 27B; _08b_case covers 0.8B. The pinned
// testbench needs literal dimensions and the matching linked variant config.
check.case public @qwen38_layer_prefill_known_case {
  %shape_ffn_size = check.literal value(17408) : index
  %shape_hidden_size = check.literal value(5120) : index
  %token_count = check.literal value(3) : index
  %epsilon = check.literal value(0.000001) : f32
  %norm_input = check.generate.fill value(2.0) : tensor<3x[%shape_hidden_size]xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<[%shape_hidden_size]xf32>
  %normalized = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf32>
  %expected_normalized = check.generate.fill value(0.49999994) : tensor<3x[%shape_hidden_size]xf32>
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized) : [index](index, f32, tensor<3x[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>)
  check.expect.close actual(%normalized) expected(%expected_normalized) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x[%shape_hidden_size]xf32>
  %normalized_f16 = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf16>
  %expected_normalized_f16 = check.generate.fill value(0.5) : tensor<3x[%shape_hidden_size]xf16>
  kernel.launch @qwen38_rmsnorm_f16_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized_f16) : [index](index, f32, tensor<3x[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf16>)
  check.expect.close actual(%normalized_f16) expected(%expected_normalized_f16) atol(0.0) rtol(0.0) nan(same) : tensor<3x[%shape_hidden_size]xf16>

  %lhs = check.generate.fill value(0.125) : tensor<3x[%shape_hidden_size]xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<3x[%shape_hidden_size]xf32>
  %sum = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<3x[%shape_hidden_size]xf32>
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_count, %lhs, %rhs, %sum) : [index](index, tensor<3x[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<3x[%shape_hidden_size]xf32>

  %gate = check.generate.fill value(0.25) : tensor<3x[%shape_ffn_size]xf32>
  %up = check.generate.fill value(0.5) : tensor<3x[%shape_ffn_size]xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<3x[%shape_ffn_size]xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<3x[%shape_ffn_size]xf32>
  kernel.launch @qwen38_swiglu_f32_prefill[%token_count](%token_count, %gate, %up, %swiglu) : [index](index, tensor<3x[%shape_ffn_size]xf32>, tensor<3x[%shape_ffn_size]xf32>, tensor<3x[%shape_ffn_size]xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x[%shape_ffn_size]xf32>
  check.return
}

check.case public @qwen38_layer_prefill_known_08b_case {
  %shape_ffn_size = check.literal value(3584) : index
  %shape_hidden_size = check.literal value(1024) : index
  %token_count = check.literal value(3) : index
  %epsilon = check.literal value(0.000001) : f32
  %norm_input = check.generate.fill value(2.0) : tensor<3x[%shape_hidden_size]xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<[%shape_hidden_size]xf32>
  %normalized = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf32>
  %expected_normalized = check.generate.fill value(0.49999994) : tensor<3x[%shape_hidden_size]xf32>
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized) : [index](index, f32, tensor<3x[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>)
  check.expect.close actual(%normalized) expected(%expected_normalized) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x[%shape_hidden_size]xf32>
  %normalized_f16 = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf16>
  %expected_normalized_f16 = check.generate.fill value(0.5) : tensor<3x[%shape_hidden_size]xf16>
  kernel.launch @qwen38_rmsnorm_f16_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized_f16) : [index](index, f32, tensor<3x[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf16>)
  check.expect.close actual(%normalized_f16) expected(%expected_normalized_f16) atol(0.0) rtol(0.0) nan(same) : tensor<3x[%shape_hidden_size]xf16>

  %lhs = check.generate.fill value(0.125) : tensor<3x[%shape_hidden_size]xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<3x[%shape_hidden_size]xf32>
  %sum = check.generate.fill value(0.0) : tensor<3x[%shape_hidden_size]xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<3x[%shape_hidden_size]xf32>
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_count, %lhs, %rhs, %sum) : [index](index, tensor<3x[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>, tensor<3x[%shape_hidden_size]xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<3x[%shape_hidden_size]xf32>

  %gate = check.generate.fill value(0.25) : tensor<3x[%shape_ffn_size]xf32>
  %up = check.generate.fill value(0.5) : tensor<3x[%shape_ffn_size]xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<3x[%shape_ffn_size]xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<3x[%shape_ffn_size]xf32>
  kernel.launch @qwen38_swiglu_f32_prefill[%token_count](%token_count, %gate, %up, %swiglu) : [index](index, tensor<3x[%shape_ffn_size]xf32>, tensor<3x[%shape_ffn_size]xf32>, tensor<3x[%shape_ffn_size]xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x[%shape_ffn_size]xf32>
  check.return
}

check.benchmark<@qwen38_layer_prefill_known_case> @qwen38_layer_prefill
