// Qwen3.8 Gated DeltaNet head-layout primitives shared by prefill and decode.

// Qwen stores sixteen Q/K heads and forty-eight V heads. ggml_repeat_4d tiles
// the complete Q/K head sequence three times, so value head h consumes Q/K
// head h % 16 rather than grouping three adjacent V heads under one Q/K head.
// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.gdn_key_heads : index
config.decl @qwen.model.gdn_value_heads : index

func.def public inline @qwen38_gdn_key_head_for_value_head(%value_head: index) -> (index) {
  %key_head_count = config.get @qwen.model.gdn_key_heads : index
  %key_head = index.rem %value_head, %key_head_count : index
  func.return %key_head : index
}

// Locks the model's tiled Q/K-to-V head mapping independently of the recurrent
// schedules that consume it.
kernel.def @qwen38_gdn_key_head_mapping_witness() {
  %unit = index.constant 1 : index
  %value_head_count = config.get @qwen.model.gdn_value_heads : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%value_head_count, %unit, %unit) : index
} launch(%output: buffer) {
  %shape_gdn_value_heads = config.get @qwen.model.gdn_value_heads : index
  %value_head0 = kernel.workitem.id<x> : index
  %value_head = index.assume %value_head0 [range(%value_head0, 0, 47)] : index
  %key_head = func.call @qwen38_gdn_key_head_for_value_head(%value_head) : (index) -> (index)
  %key_head_i32 = index.cast %key_head : index to i32
  %c0_offset = index.constant 0 : offset
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%shape_gdn_value_heads]xi32>
  view.store %key_head_i32, %output_view[%value_head] : i32, view<[%shape_gdn_value_heads]xi32>
  kernel.return
}

check.case public @qwen38_gdn_key_head_mapping_case {
  %shape_gdn_value_heads = config.get @qwen.model.gdn_value_heads : index
  %actual = check.generate.fill value(-1) : tensor<[%shape_gdn_value_heads]xi32>
  %expected = check.generate.iota offset(0) step(1) period(16) : tensor<[%shape_gdn_value_heads]xi32>
  kernel.launch @qwen38_gdn_key_head_mapping_witness(%actual) : (tensor<[%shape_gdn_value_heads]xi32>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<[%shape_gdn_value_heads]xi32>
  check.return
}
