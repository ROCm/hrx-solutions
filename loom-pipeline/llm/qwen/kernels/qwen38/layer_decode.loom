  %expected_sum = check.generate.fill value(0.0625) : tensor<[%shape_hidden_size]xf32>
  kernel.launch @qwen38_residual_add_f32_decode(%lhs, %rhs, %sum) : (tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<[%shape_hidden_size]xf32>

  %gate = check.generate.fill value(0.25) : tensor<[%shape_ffn_size]xf32>
  %up = check.generate.fill value(0.5) : tensor<[%shape_ffn_size]xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<[%shape_ffn_size]xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<[%shape_ffn_size]xf32>
  kernel.launch @qwen38_swiglu_f32_decode(%gate, %up, %swiglu) : (tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_ffn_size]xf32>
  check.return
}

