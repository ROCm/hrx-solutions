check.case public @llm_primitives_llama_known_case {
  %epsilon = check.literal value(0.00001) : f32
  %input = check.generate.fill value(2.0) : tensor<3x3072xf32>
  %weight = check.generate.fill value(0.5) : tensor<3072xf32>
  %normalized = check.generate.fill value(0.0) : tensor<3x3072xf32>
  %expected_normalized = check.generate.fill value(0.49999937415122986) : tensor<3x3072xf32>
  kernel.launch @llm_rmsnorm_f32_known_fixture(%epsilon, %input, %weight, %normalized) : (f32, tensor<3x3072xf32>, tensor<3072xf32>, tensor<3x3072xf32>)
  check.expect.close actual(%normalized) expected(%expected_normalized) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x3072xf32>
  %normalized_f16 = check.generate.fill value(0.0) : tensor<3x3072xf16>
  %expected_normalized_f16 = check.generate.fill value(0.5) : tensor<3x3072xf16>
  kernel.launch @llm_rmsnorm_f16_known_fixture(%epsilon, %input, %weight, %normalized_f16) : (f32, tensor<3x3072xf32>, tensor<3072xf32>, tensor<3x3072xf16>)
  check.expect.close actual(%normalized_f16) expected(%expected_normalized_f16) atol(0.0) rtol(0.0) nan(same) : tensor<3x3072xf16>
  %lhs = check.generate.fill value(0.125) : tensor<3x3072xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<3x3072xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<3x3072xf32>
  kernel.launch @llm_residual_add_f32_known_fixture(%lhs, %rhs, %lhs) : (tensor<3x3072xf32>, tensor<3x3072xf32>, tensor<3x3072xf32>)
  check.expect.close actual(%lhs) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<3x3072xf32>
  %gate = check.generate.fill value(0.25) : tensor<3x8192xf32>
  %up = check.generate.fill value(0.5) : tensor<3x8192xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<3x8192xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<3x8192xf32>
  kernel.launch @llm_swiglu_f32_known_fixture(%gate, %up, %swiglu) : (tensor<3x8192xf32>, tensor<3x8192xf32>, tensor<3x8192xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<3x8192xf32>
  check.return
}

