// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.ffn_size : index
config.decl @qwen.model.hidden_divisor : f32
config.decl @qwen.model.hidden_size : index

template.decl @qwen38.rmsnorm_f32.row(%input_row_count: index, %input_row: index, %output_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
template.decl @llm.rmsnorm.row(%hidden_size0: index, %element_count_f32: f32, %input_row_count: index, %input_row: index, %output_origin: offset, %output_is_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
template.decl @llm.residual_add_f32.row(%hidden_size0: index, %row_count0: index, %row0: index, %lhs: buffer, %rhs: buffer, %output: buffer)
template.decl @llm.swiglu_f32.row(%ffn_size0: index, %row_count0: index, %row0: index, %gate: buffer, %up: buffer, %output: buffer)

// Elementwise and normalization primitives shared by Qwen3.8 decode layers.
// Quantized projections and attention/GDN state transitions remain in their
// own files so command programs can select and compose them independently.

amdgpu.target<gfx11-generic> @qwen38_layer_gfx11_wave32 {subgroup_size = 32}

// Callers provide a contiguous F32 row domain, its F32 width divisor, and
// disjoint input/weight/output buffers. All 256 threads participate in the
// original reduction order. Output precision specializes only the final store.
template.def<@llm.rmsnorm.row> device @llm_rmsnorm_row(%hidden_size0: index, %element_count_f32: f32, %input_row_count: index, %input_row: index, %output_origin: offset, %output_is_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 1, 32768)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %c0_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%input_row_count]x[%hidden_size]xf32>
  %weight_view = buffer.view %weight_noalias[%c0_offset] : buffer -> view<[%hidden_size]xf32>
  %thread_sum = scf.for %element = [%lane to %hidden_size step %workgroup_size](%partial_sum = %c0_f32 : f32) -> (f32) {
    %input_value = view.load %input_view[%input_row, %element] : view<[%input_row_count]x[%hidden_size]xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %input_value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %partial_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %sum = kernel.workgroup.reduce<addf> %thread_sum : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %element_count_f32 : f32
  %biased_mean = scalar.addf<nnan|ninf|nsz> %mean, %epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  scf.for %element = [%lane to %hidden_size step %workgroup_size] {
    %input_value = view.load %input_view[%input_row, %element] : view<[%input_row_count]x[%hidden_size]xf32> -> f32
    %weight = view.load %weight_view[%element] : view<[%hidden_size]xf32> -> f32
    %normalized = scalar.mulf<nnan|ninf|nsz> %input_value, %inverse_rms : f32
    %result = scalar.mulf<nnan|ninf|nsz> %normalized, %weight : f32
    scf.if %output_is_f16 {
      %output_view = buffer.view %output_noalias[%output_origin] : buffer -> view<[%hidden_size]xf16>
      %result_f16 = scalar.fptrunc %result : f32 to f16
      view.store %result_f16, %output_view[%element] : f16, view<[%hidden_size]xf16>
    } else {
      %output_view = buffer.view %output_noalias[%output_origin] : buffer -> view<[%hidden_size]xf32>
      view.store %result, %output_view[%element] : f32, view<[%hidden_size]xf32>
    }
  }
  template.return
}

// Keep the existing model adapter for decode, final-row and output-span
// callers. Geometry belongs to the catalog; arithmetic belongs to the body.
template.def<@qwen38.rmsnorm_f32.row> device @qwen38_rmsnorm_f32_row(%input_row_count: index, %input_row: index, %output_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %hidden_size = config.get @qwen.model.hidden_size : index
  %divisor = config.get @qwen.model.hidden_divisor : f32
  %output_is_f16 = scalar.constant false : i1
  template.apply<@llm.rmsnorm.row>(%hidden_size, %divisor, %input_row_count, %input_row, %output_origin, %output_is_f16, %epsilon, %input, %weight, %output) : (index, f32, index, index, offset, i1, f32, buffer, buffer, buffer)
  template.return
}

// Contiguous rows, complete 1024-channel tiles, four F32 values per lane.
// No noalias promise: the output may update either input in place.
template.def<@llm.residual_add_f32.row> device @llm_residual_add_f32_row(%hidden_size0: index, %row_count0: index, %row0: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 1024, 32768), multiple_of(%hidden_size0, 1024)] : index
  %row_count, %row = index.assume %row_count0, %row0 [range(%row_count0, 1, 512), lt(%row0, %row_count0)] : index, index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c4 = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %workgroup_base, %lane : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 32764), multiple_of(%element0, 4), lt(%element0, %hidden_size)] : index
  %lhs_view = buffer.view %lhs[%c0_offset] : buffer -> view<[%row_count]x[%hidden_size]xf32>
  %rhs_view = buffer.view %rhs[%c0_offset] : buffer -> view<[%row_count]x[%hidden_size]xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%row_count]x[%hidden_size]xf32>
  %lhs_values = vector.load %lhs_view[%row, %element] : view<[%row_count]x[%hidden_size]xf32> -> vector<4xf32>
  %rhs_values = vector.load %rhs_view[%row, %element] : view<[%row_count]x[%hidden_size]xf32> -> vector<4xf32>
  %result = vector.addf<nnan|ninf|nsz> %lhs_values, %rhs_values : vector<4xf32>
  vector.store %result, %output_view[%row, %element] : vector<4xf32>, view<[%row_count]x[%hidden_size]xf32>
  template.return
}

// Scalar SiLU and multiply retain the F32 boundary and original flags.
template.def<@llm.swiglu_f32.row> device @llm_swiglu_f32_row(%ffn_size0: index, %row_count0: index, %row0: index, %gate: buffer, %up: buffer, %output: buffer) {
  %ffn_size = index.assume %ffn_size0 [range(%ffn_size0, 256, 32768), multiple_of(%ffn_size0, 256)] : index
  %row_count, %row = index.assume %row_count0, %row0 [range(%row_count0, 1, 512), lt(%row0, %row_count0)] : index, index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %element0 = index.add %workgroup_base, %lane : index
  %element = index.assume %element0 [range(%element0, 0, 32767), lt(%element0, %ffn_size)] : index
  %gate_view = buffer.view %gate[%c0_offset] : buffer -> view<[%row_count]x[%ffn_size]xf32>
  %up_view = buffer.view %up[%c0_offset] : buffer -> view<[%row_count]x[%ffn_size]xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%row_count]x[%ffn_size]xf32>
  %gate_value = view.load %gate_view[%row, %element] : view<[%row_count]x[%ffn_size]xf32> -> f32
  %up_value = view.load %up_view[%row, %element] : view<[%row_count]x[%ffn_size]xf32> -> f32
  %activated_gate = scalar.siluf<afn> %gate_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %activated_gate, %up_value : f32
  view.store %result, %output_view[%row, %element] : f32, view<[%row_count]x[%ffn_size]xf32>
  template.return
}

// Decode keeps the same coalesced reduction schedule as the shared row body.
kernel.def target(@qwen38_layer_gfx11_wave32) export("qwen38_rmsnorm_f32_decode") @qwen38_rmsnorm_f32_decode() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  template.apply<@qwen38.rmsnorm_f32.row>(%c1, %c0, %origin, %epsilon, %input, %weight, %output) : (index, index, offset, f32, buffer, buffer, buffer)
  kernel.return
}

// Selects the final active prefill row from control[0] without baking a
// prompt-specific residual offset into the reusable command buffer.
kernel.def target(@qwen38_layer_gfx11_wave32) export("qwen38_rmsnorm_f32_prefill_last") @qwen38_rmsnorm_f32_prefill_last() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_offset = index.constant 0 : offset
  %c512 = index.constant 512 : index
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[%c0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %last_token0 = index.sub %token_count, %c1 : index
  %last_token = index.assume %last_token0 [range(%last_token0, 0, 511)] : index
  template.apply<@qwen38.rmsnorm_f32.row>(%c512, %last_token, %c0_offset, %epsilon, %input, %weight, %output) : (index, index, offset, f32, buffer, buffer, buffer)
  kernel.return
}

// Adds one projection result into its residual stream. Four adjacent F32
// elements travel together; each workgroup covers 1024 hidden channels.
kernel.def export("qwen38_residual_add_f32_decode") @qwen38_residual_add_f32_decode() {
  %c1 = index.constant 1 : index
  %hidden_size = config.get @qwen.model.hidden_size : index
  %channels_per_group = index.constant 1024 : index
  %bounded_hidden_size = index.assume %hidden_size [range(%hidden_size, 1024, 32768), multiple_of(%hidden_size, 1024)] : index
  %workgroup_count = index.div %bounded_hidden_size, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %hidden_size = config.get @qwen.model.hidden_size : index
  %row_count = index.constant 1 : index
  %row = index.constant 0 : index
  template.apply<@llm.residual_add_f32.row>(%hidden_size, %row_count, %row, %lhs, %rhs, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

// Applies SwiGLU to paired gate and up projections. This ordinary F32 boundary
// is the correctness baseline; a later schedule may fuse Q8 publication when
// the command-program trace proves that extra materialization is significant.
kernel.def export("qwen38_swiglu_f32_decode") @qwen38_swiglu_f32_decode() {
  %c1 = index.constant 1 : index
  %ffn_size = config.get @qwen.model.ffn_size : index
  %channels_per_group = index.constant 256 : index
  %bounded_ffn_size = index.assume %ffn_size [range(%ffn_size, 256, 32768), multiple_of(%ffn_size, 256)] : index
  %workgroup_count = index.div %bounded_ffn_size, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%gate: buffer, %up: buffer, %output: buffer) {
  %ffn_size = config.get @qwen.model.ffn_size : index
  %row_count = index.constant 1 : index
  %row = index.constant 0 : index
  template.apply<@llm.swiglu_f32.row>(%ffn_size, %row_count, %row, %gate, %up, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

// The pinned testbench accepts check literals, not case-body config.get.
// Existing case names cover 27B; _08b_case names cover 0.8B. Link each case
// with the matching variant config so fixture and kernel dimensions agree.
check.case public @qwen38_rmsnorm_f32_decode_known_case {
  %shape_hidden_size = check.literal value(5120) : index
  %epsilon = check.literal value(0.000001) : f32
  %input = check.generate.fill value(2.0) : tensor<[%shape_hidden_size]xf32>
  %weight = check.generate.fill value(0.5) : tensor<[%shape_hidden_size]xf32>
  %output = check.generate.fill value(0.0) : tensor<[%shape_hidden_size]xf32>
  %expected = check.generate.fill value(0.49999994) : tensor<[%shape_hidden_size]xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %input, %weight, %output) : (f32, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_hidden_size]xf32>
  check.return
}

check.case public @qwen38_residual_add_f32_decode_known_case {
  %shape_hidden_size = check.literal value(5120) : index
  %lhs = check.generate.fill value(0.125) : tensor<[%shape_hidden_size]xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<[%shape_hidden_size]xf32>
  %output = check.generate.fill value(0.0) : tensor<[%shape_hidden_size]xf32>
  %expected = check.generate.fill value(0.0625) : tensor<[%shape_hidden_size]xf32>
  kernel.launch @qwen38_residual_add_f32_decode(%lhs, %rhs, %output) : (tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%shape_hidden_size]xf32>
  check.return
}

check.case public @qwen38_swiglu_f32_decode_known_case {
  %shape_ffn_size = check.literal value(17408) : index
  %gate = check.generate.fill value(0.25) : tensor<[%shape_ffn_size]xf32>
  %up = check.generate.fill value(0.5) : tensor<[%shape_ffn_size]xf32>
  %output = check.generate.fill value(0.0) : tensor<[%shape_ffn_size]xf32>
  %expected = check.generate.fill value(0.07027235627174377) : tensor<[%shape_ffn_size]xf32>
  kernel.launch @qwen38_swiglu_f32_decode(%gate, %up, %output) : (tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_ffn_size]xf32>
  check.return
}

check.case public @qwen38_layer_decode_primitives_known_case {
  %shape_ffn_size = check.literal value(17408) : index
  %shape_hidden_size = check.literal value(5120) : index
  %epsilon = check.literal value(0.000001) : f32
  %norm_input = check.generate.fill value(2.0) : tensor<[%shape_hidden_size]xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<[%shape_hidden_size]xf32>
  %normalized = check.generate.fill value(0.0) : tensor<[%shape_hidden_size]xf32>
  %expected_normalized = check.generate.fill value(0.49999994) : tensor<[%shape_hidden_size]xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %norm_input, %norm_weight, %normalized) : (f32, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>)
  check.expect.close actual(%normalized) expected(%expected_normalized) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_hidden_size]xf32>

  %lhs = check.generate.fill value(0.125) : tensor<[%shape_hidden_size]xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<[%shape_hidden_size]xf32>
  %sum = check.generate.fill value(0.0) : tensor<[%shape_hidden_size]xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<[%shape_hidden_size]xf32>
  kernel.launch @qwen38_residual_add_f32_decode(%lhs, %rhs, %sum) : (tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>, tensor<[%shape_hidden_size]xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<[%shape_hidden_size]xf32>

  %gate = check.generate.fill value(0.25) : tensor<[%shape_ffn_size]xf32>
  %up = check.generate.fill value(0.5) : tensor<[%shape_ffn_size]xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<[%shape_ffn_size]xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<[%shape_ffn_size]xf32>
  kernel.launch @qwen38_swiglu_f32_decode(%gate, %up, %swiglu) : (tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>, tensor<[%shape_ffn_size]xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<[%shape_ffn_size]xf32>
  check.return
}

