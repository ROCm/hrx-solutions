  %element_count = index.mul %bounded_token_count, %bounded_input_size : index
  %group_count0 = index.div %element_count, %elements_per_group : index
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 524288), le(%group_count0, %group_capacity)] : index
  %group0 = kernel.workgroup.id<x> : index
  %group = index.assume %group0 [lt(%group0, %group_capacity)] : index
  %groups_per_row = index.div %bounded_input_size, %elements_per_group : index
  %token = index.div %group, %groups_per_row : index
  %specialized, %one_row, %reverse_minima = func.call @ggml_qk_mmvq_compat_select(%bounded_token_count, %token, %row_origin, %fixed_count, %count_origin, %count_view) : (index, index, index, i32, offset, buffer) -> (i1, i1, i1)
  %publish_output = scalar.constant true : i1
  %mmq_estimate = func.call @ggml_qk_mmq_compat_select(%bounded_token_count, %token, %row_origin, %fixed_count, %count_origin, %count_view) : (index, index, index, i32, offset, buffer) -> (i1)
  template.apply<@ggml.quantize_q8_1_x4.group_body_policy>(%specialized, %mmq_estimate, %publish_output, %group_count, %group, %input, %output) : (i1, i1, i1, index, index, buffer, buffer)
  kernel.return
}
