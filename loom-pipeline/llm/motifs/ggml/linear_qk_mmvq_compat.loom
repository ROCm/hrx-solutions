// Numerical policy selection for wave32 Q4_K/Q6_K projections.
// Count view is one generic i32 at an explicit byte origin. A fixed count
// bypasses the view, so callers can pass an unread decode-position buffer.
// Only logical counts 1 and 3 select compatibility arithmetic. Capacity owns
// allocation/strides; row_origin identifies the first logical matrix column.
func.def public inline @ggml_qk_mmvq_compat_select(%capacity: index, %token: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count_view: buffer) -> (i1, i1, i1) {
  %c0 = index.constant 0 : index
  // Generic logical-count view: no Llama packet decoding in numerical code.
  // A nonnegative fixed count bypasses the view entirely (decode word0 is position).
  %zero32 = scalar.constant 0 : i32
  %fixed = scalar.cmpi sge, %fixed_count, %zero32 : i32
  %logical_count = scf.if %fixed -> (i32) {
    scf.yield %fixed_count : i32
  } else {
    %count_words = buffer.view %count_view[%count_origin] : buffer -> view<1xi32>
    %n = view.load %count_words[0] : view<1xi32> -> i32
    scf.yield %n : i32
  }
  %one32 = scalar.constant 1 : i32
  %one_row = scalar.cmpi eq, %logical_count, %one32 : i32
  %one = index.constant 1 : index
  %three32 = scalar.constant 3 : i32
  %three = index.constant 3 : index
  %is_three = scalar.cmpi eq, %logical_count, %three32 : i32
  %active_limit = scf.select %one_row, %one, %three : index
  %supported_count = scalar.ori %one_row, %is_three : i1
  %origin_fits = index.cmp ule, %row_origin, %capacity : index
  %remaining = scf.if %origin_fits -> (index) {
    %n = index.sub %capacity, %row_origin : index
    scf.yield %n : index
  } else {
    scf.yield %c0 : index
  }
  %active_fits = index.cmp uge, %remaining, %active_limit : index
  %at_or_after_origin = index.cmp uge, %token, %row_origin : index
  %relative_row = scf.if %at_or_after_origin -> (index) {
    %r = index.sub %token, %row_origin : index
    scf.yield %r : index
  } else {
    scf.yield %three : index
  }
  %active_row = index.cmp ult, %relative_row, %active_limit : index
  %valid_count = scalar.andi %supported_count, %active_fits : i1
  %specialized = scalar.andi %valid_count, %active_row : i1
  %reverse_minima = index.cmp ne, %relative_row, %c0 : index
  func.return %specialized, %one_row, %reverse_minima : i1, i1, i1
}

// Strict descending XOR tree used only by explicitly wave32 callers.
func.def public inline @ggml_qk_mmvq_compat_reduce(%lane_acc: f32) -> (f32) {
  %shuffle_width = scalar.constant 32 : i32
  %xor16 = scalar.constant 16 : i32
  %peer16, %valid16 = kernel.subgroup.shuffle<xor> %lane_acc, %xor16, %shuffle_width : f32, i32, i32
  %sum16 = scalar.addf %lane_acc, %peer16 : f32
  %xor8 = scalar.constant 8 : i32
  %peer8, %valid8 = kernel.subgroup.shuffle<xor> %sum16, %xor8, %shuffle_width : f32, i32, i32
  %sum8 = scalar.addf %sum16, %peer8 : f32
  %xor4 = scalar.constant 4 : i32
  %peer4, %valid4 = kernel.subgroup.shuffle<xor> %sum8, %xor4, %shuffle_width : f32, i32, i32
  %sum4 = scalar.addf %sum8, %peer4 : f32
  %xor2 = scalar.constant 2 : i32
  %peer2, %valid2 = kernel.subgroup.shuffle<xor> %sum4, %xor2, %shuffle_width : f32, i32, i32
  %sum2 = scalar.addf %sum4, %peer2 : f32
  %xor1 = scalar.constant 1 : i32
  %peer1, %valid1 = kernel.subgroup.shuffle<xor> %sum2, %xor1, %shuffle_width : f32, i32, i32
  %ordered_dot = scalar.addf %sum2, %peer1 : f32
  func.return %ordered_dot : f32
}

// Generic MMQ active-extent selection, shared by explicit producer/consumer policies.
func.def public inline @ggml_qk_mmq_compat_select(%capacity: index, %token: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count_view: buffer) -> (i1) {
  %zero = scalar.constant 0 : i32
  %fixed = scalar.cmpi sge, %fixed_count, %zero : i32
  %count = scf.if %fixed -> (i32) {
    scf.yield %fixed_count : i32
  } else {
    %view = buffer.view %count_view[%count_origin] : buffer -> view<1xi32>
    %value = view.load %view[0] : view<1xi32> -> i32
    scf.yield %value : i32
  }
  %eight = scalar.constant 8 : i32
  %mmq = scalar.cmpi sgt, %count, %eight : i32
  %zero_index = index.constant 0 : index
  %origin_fits = index.cmp ule, %row_origin, %capacity : index
  %remaining = scf.if %origin_fits -> (index) {
    %n = index.sub %capacity, %row_origin : index
    scf.yield %n : index
  } else {
    scf.yield %zero_index : index
  }
  %n = index.cast %count : i32 to index
  %fits = index.cmp ule, %n, %remaining : index
  %after_origin = index.cmp uge, %token, %row_origin : index
  %relative = scf.if %after_origin -> (index) {
    %r = index.sub %token, %row_origin : index
    scf.yield %r : index
  } else {
    scf.yield %capacity : index
  }
  %active = index.cmp ult, %relative, %n : index
  %valid = scalar.andi %origin_fits, %fits : i1
  %selected = scalar.andi %mmq, %valid : i1
  %selected_active = scalar.andi %selected, %active : i1
  func.return %selected_active : i1
}

