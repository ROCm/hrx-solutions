{
  "format": 1,
  "id": "moonshine-streaming-tiny",
  "contract": "moonshine-streaming-tiny-assets-v1",
  "description": "Moonshine streaming tiny English speech recognition",
  "assets": [
    {
      "role": "checkpoint",
      "path": "model.safetensors",
      "required": true
    },
    {
      "role": "tokenizer",
      "path": "tokenizer.json",
      "required": true
    },
    {
      "role": "configuration",
      "path": "config.json",
      "required": true
    },
    {
      "role": "rotary",
      "path": "rotary.safetensors",
      "required": true
    }
  ],
  "definition": {
    "kind": "recognition",
    "prepare": "prepare.loom",
    "control": "control.loom",
    "sources": [
      "convolution.loom",
      "decoder.loom",
      "decoder_attention.loom",
      "decoder_state.loom",
      "encoder.loom",
      "encoder_attention.loom",
      "encoder_state.loom",
      "frontend.loom",
      "initialize.loom",
      "normalization.loom",
      "pointwise.loom",
      "projection.loom",
      "reset.loom"
    ],
    "assets": "."
  }
}
