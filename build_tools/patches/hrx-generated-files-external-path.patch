diff --git a/build_tools/bazel/generate.bzl b/build_tools/bazel/generate.bzl
--- a/build_tools/bazel/generate.bzl
+++ b/build_tools/bazel/generate.bzl
@@ -34,6 +34,10 @@ def _resolve_output_arguments(ctx, outputs):
     outputs_by_basename = {}
     for output in outputs:
         output_path = output.short_path
+        # External generated files have ../<canonical-repo>/ before the package.
+        # output_args keys are package-relative in both root and external uses.
+        if output_path.startswith("../"):
+            output_path = output_path.split("/", 2)[2]
         if package_prefix and output_path.startswith(package_prefix):
             output_path = output_path[len(package_prefix):]
         outputs_by_path[output_path] = output
